# Installed at /etc/systemd/system/dotmarc-offsite-backup.timer. Enable with:
#   systemctl daemon-reload && systemctl enable --now dotmarc-offsite-backup.timer
[Unit]
Description=Nightly encrypted dotMARC backup to S3

[Timer]
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target

#!/usr/bin/env bash
# Encrypted offsite backup of dotMARC to S3, the same way voip-ai-agent backs up.
#
# What's in it, everything needed to rebuild dotMARC on a fresh Droplet:
#   - the Postgres database (pg_dump), which also holds the keys that decrypt stored integration secrets
#   - .env (Graph and Entra client secrets, the Postgres password, the image and version to run)
#   - docker-compose.yml and Caddyfile, and the image dotMARC was running
# NOT included on purpose: .backup.conf, since the passphrase must never travel with what it protects.
# The archive is AES-256 encrypted (openssl, PBKDF2) with the passphrase before it leaves the server, so it never
# lands anywhere unencrypted. Retention: dailies kept 30 days, a backup taken on the 1st of a month kept forever.
#
# Config lives in /opt/dotmarc/.backup.conf (root, mode 600, not in git, not in the backup). Keep the passphrase
# somewhere offline too: without it a backup can't be restored. Quote every value: the file is read as shell, so an
# unquoted passphrase with a space in it breaks.
#   S3_BUCKET='my-bucket'
#   S3_REGION='eu-west-2'
#   AWS_ACCESS_KEY_ID='...'
#   AWS_SECRET_ACCESS_KEY='...'
#   BACKUP_PASSPHRASE='...'
#   S3_PREFIX='dotmarc-backups'   # optional
#   S3_ENDPOINT_URL='...'         # optional, for DigitalOcean Spaces or another S3-compatible service
#
# Run nightly by dotmarc-offsite-backup.timer; run it by hand to back up now, or `dotmarc-offsite-backup list` to
# see what's stored. Restore with dotmarc-offsite-restore. Status: /var/lib/dotmarc/offsite-backup-status.json.
set -euo pipefail

APP=${DOTMARC_DIR:-/opt/dotmarc}
CONF=$APP/.backup.conf
STATE=${DOTMARC_STATE_DIR:-/var/lib/dotmarc}
STATUS=$STATE/offsite-backup-status.json
mkdir -p "$STATE"

write_status() { # ok|error|running message [key] [size]
  STATE_ARG=$1 MSG=$2 KEY_ARG=${3:-} SIZE_ARG=${4:-} STATUS="$STATUS" python3 - <<'PY'
import json, os, time
obj = {"configured": True, "ok": os.environ["STATE_ARG"] == "ok", "running": os.environ["STATE_ARG"] == "running",
       "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "message": os.environ["MSG"]}
if os.environ.get("KEY_ARG"):
    obj["key"] = os.environ["KEY_ARG"]
if os.environ.get("SIZE_ARG"):
    obj["size"] = int(os.environ["SIZE_ARG"])
json.dump(obj, open(os.environ["STATUS"], "w"))
PY
}

if [ ! -f "$CONF" ]; then
  python3 -c 'import json, sys; json.dump({"configured": False}, open(sys.argv[1], "w"))' "$STATUS"
  echo "Not configured: $CONF is missing (see the top of this script)"
  exit 0
fi

# set -a exports what's sourced: openssl reads the passphrase, and boto3 the keys, from the environment.
set -a
# shellcheck disable=SC1090
source "$CONF"
set +a
: "${S3_BUCKET:?}" "${S3_REGION:?}" "${AWS_ACCESS_KEY_ID:?}" "${AWS_SECRET_ACCESS_KEY:?}" "${BACKUP_PASSPHRASE:?}"
PREFIX="${S3_PREFIX:-dotmarc-backups}"
PREFIX="${PREFIX%/}"
export PREFIX

if [ "${1:-}" = "list" ]; then
  python3 - <<'PY'
import boto3, os
s3 = boto3.client("s3", region_name=os.environ["S3_REGION"], endpoint_url=os.environ.get("S3_ENDPOINT_URL") or None)
items = []
for page in s3.get_paginator("list_objects_v2").paginate(Bucket=os.environ["S3_BUCKET"], Prefix=os.environ["PREFIX"] + "/"):
    items += page.get("Contents", [])
for obj in sorted(items, key=lambda o: o["LastModified"], reverse=True):
    print(f'{obj["LastModified"]:%Y-%m-%d %H:%M}  {obj["Size"]:>12,}  {obj["Key"]}')
print(f"{len(items)} backup(s) in s3://{os.environ['S3_BUCKET']}/{os.environ['PREFIX']}/")
PY
  exit 0
fi

# One backup at a time: the nightly timer and a run by hand mustn't interleave.
exec 9>/tmp/dotmarc-offsite-backup.lock
if ! flock -n 9; then
  echo "Another backup is already running, skipping"
  exit 0
fi

WORK=$(mktemp -d /tmp/dotmarc-offsite-backup.XXXXXX)
trap 'rm -rf "$WORK"' EXIT
trap 'write_status error "Backup failed (line $LINENO); see journalctl -u dotmarc-offsite-backup"' ERR
trap 'write_status error "Backup interrupted"; exit 1' TERM HUP INT
write_status running "Backup in progress"

cd "$APP"
mkdir "$WORK/backup"
# A custom-format dump: consistent while dotMARC keeps running, and restored with pg_restore.
docker compose exec -T postgres pg_dump -U dotmarc -d dotmarc -Fc > "$WORK/backup/dotmarc.dump"
cp .env "$WORK/backup/env"
cp docker-compose.yml "$WORK/backup/docker-compose.yml"
[ -f Caddyfile ] && cp Caddyfile "$WORK/backup/Caddyfile"
docker compose images app --format json > "$WORK/backup/image.json" 2>/dev/null || true

STAMP=$(date -u +%Y-%m-%d_%H%M%S)
KEY="$PREFIX/dotmarc-backup-$STAMP.tar.gz.enc"
tar -czf - -C "$WORK" backup |
  openssl enc -aes-256-cbc -md sha256 -pbkdf2 -iter 200000 -salt -pass env:BACKUP_PASSPHRASE > "$WORK/payload.enc"
SIZE=$(stat -c%s "$WORK/payload.enc")

export WORK KEY
python3 - <<'PY'
import boto3, datetime, os
s3 = boto3.client("s3", region_name=os.environ["S3_REGION"], endpoint_url=os.environ.get("S3_ENDPOINT_URL") or None)
bucket = os.environ["S3_BUCKET"]
s3.upload_file(os.environ["WORK"] + "/payload.enc", bucket, os.environ["KEY"])

# Retention: dailies kept 30 days; a backup taken on the 1st of a month is kept forever.
cutoff = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(days=30)
for page in s3.get_paginator("list_objects_v2").paginate(Bucket=bucket, Prefix=os.environ["PREFIX"] + "/"):
    for obj in page.get("Contents", []):
        base = obj["Key"].rsplit("/", 1)[-1]
        if not base.startswith("dotmarc-backup-"):
            continue
        day = base[len("dotmarc-backup-"):][:10]  # YYYY-MM-DD
        if obj["LastModified"] < cutoff and not day.endswith("-01"):
            s3.delete_object(Bucket=bucket, Key=obj["Key"])
PY

write_status ok "Backed up successfully" "$KEY" "$SIZE"
echo "Backed up $SIZE bytes to s3://$S3_BUCKET/$KEY"

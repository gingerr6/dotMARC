@page "/domains"
@layout DotMarc.Components.Layout.ManageLayout
@attribute [Authorize(Policy = "DomainsWrite")]
@using DotMarc.Data
@using DotMarc.Components.Dialogs
@using DotMarc.Components.Shared
@using DotMarc.Notifications
@using DotMarc.Psa
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AuditActorAccessor AuditActorAccessor
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject PsaDirectory PsaDirectory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>dotMARC - Manage Domains</PageTitle>
<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4">Manage domains</MudText>
    <DocsLink Href="https://dotmarc.app/docs/scope" Text="What dotMARC monitors for a domain" Class="ml-2" />
</div>

<AuthorizeView Policy="DomainsAdd">
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid>
            <MudItem xs="@(_isLimited ? 6 : 9)">
                <MudTextField @bind-Value="_newDomainName" Label="Domain name" Placeholder="contoso.example" Variant="Variant.Outlined"
                              Error="@(_addError is not null)" ErrorText="@_addError" Immediate="true" />
            </MudItem>
            @if (_isLimited)
            {
                @* Someone limited to Groups only sees domains in their Groups, so a new domain has to go in one. *@
                <MudItem xs="3">
                    <SearchableMultiSelect TValue="int" Options="_groupOptions" @bind-SelectedValues="_newDomainGroupIds" Label="Groups" Variant="Variant.Outlined"
                                           MultiSelectionTextFunc="@(selected => selected.Count == 0 ? "Choose at least one" : $"{selected.Count} group(s)")" />
                </MudItem>
            }
            <MudItem xs="3" Class="d-flex align-start" Style="gap:0.5rem">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="button-beside-input" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddDomainAsync">Add domain</MudButton>
                <AuthorizeView Policy="DomainsImport" Context="importAuthState">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="button-beside-input" StartIcon="@Icons.Material.Filled.UploadFile"
                               Href="/domains/import">Import domains</MudButton>
                </AuthorizeView>
            </MudItem>
        </MudGrid>
    </MudPaper>
</AuthorizeView>

@if (_domains is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @foreach (var failed in _psaLists.Where(list => list.FailureReason is not null))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            @failed.FailureReason Its column shows the saved companies but can't be changed until it loads.
        </MudAlert>
    }
    <MudTable Items="_domains" Hover="true" T="DomainRow" CustomHeader="true" Filter="RowMatchesFilters">
        @* The filters apply to every column, so the toggle sits above the table rather than inside a column heading. *@
        <ToolBarContent>
            <MudSpacer />
            <MudButton Variant="@(_showFilters ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList"
                       OnClick="@(() => _showFilters = !_showFilters)">@(_showFilters ? "Hide filters" : "Filters")</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <tr>
                <MudTh></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<DomainRow, object>(d => d.Name)"><Hint Text="The domain, as it appears in DMARC reports.">Domain</Hint></MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<DomainRow, object>(d => d.GroupIds.Count)"><Hint Text="The clients (Groups) the domain belongs to. Groups decide who can see it.">Groups</Hint></MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<DomainRow, object>(d => d.TagIds.Count)"><Hint Text="Your own labels, for filtering. They don't change who can see what.">Tags</Hint></MudTableSortLabel></MudTh>
                @foreach (var list in _psaLists)
                {
                    <MudTh>@list.Psa.CompanyLabel() override</MudTh>
                }
                <MudTh><MudTableSortLabel SortBy="new Func<DomainRow, object>(d => d.IsMonitored)"><Hint Text="Whether dotMARC actively watches the domain: its daily DNS checks run and it can raise alerts. Turn off for domains you only keep for their reports.">Monitored</Hint></MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<DomainRow, object>(d => d.ReportCount)"><Hint Text="How many DMARC reports dotMARC holds for the domain.">Reports</Hint></MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<DomainRow, object>(d => d.LastReportReceivedUtc ?? DateTimeOffset.MinValue)"><Hint Text="When the most recent DMARC report for the domain arrived.">Last report</Hint></MudTableSortLabel></MudTh>
                <MudTh></MudTh>
            </tr>
            @if (_showFilters)
            {
            <tr>
                <MudTh></MudTh>
                <MudTh><MudTextField T="string" @bind-Value="_domainFilter" Placeholder="Search" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" /></MudTh>
                <MudTh>
                    <SearchableSelect TValue="int?" Options="_groupFilterOptions" Value="_groupFilter" ValueChanged="@(v => _groupFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense" />
                </MudTh>
                <MudTh>
                    <SearchableSelect TValue="int?" Options="_tagFilterOptions" Value="_tagFilter" ValueChanged="@(v => _tagFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense" />
                </MudTh>
                @foreach (var list in _psaLists)
                {
                    <MudTh>
                        <SearchableSelect TValue="string" Options="@_companyFilterOptions.GetValueOrDefault(list.Psa, [])" Value="@_companyFilters.GetValueOrDefault(list.Psa)"
                                          ValueChanged="@(companyId => _companyFilters[list.Psa] = companyId)" Clearable="true" Placeholder="Any" Margin="Margin.Dense" />
                    </MudTh>
                }
                <MudTh>
                    <MudSelect T="bool?" Value="_monitoredFilter" ValueChanged="@(v => _monitoredFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                        <MudSelectItem T="bool?" Value="true">Yes</MudSelectItem>
                        <MudSelectItem T="bool?" Value="false">No</MudSelectItem>
                    </MudSelect>
                </MudTh>
                <MudTh>
                    <MudNumericField T="int?" @bind-Value="_minReportCountFilter" Placeholder="Min" Margin="Margin.Dense" Min="0" />
                </MudTh>
                <MudTh><MudTextField T="string" @bind-Value="_lastReportFilter" Placeholder="Search" Immediate="true" Margin="Margin.Dense" /></MudTh>
                <MudTh></MudTh>
            </tr>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="width: 2.5rem;">
                <AuthorizeView Policy="DomainsReorder" Context="authState">
                    @* Drag/drop attributes live on plain <div>s, not MudTd itself: MudTd is a
                       MudBlazor component, and whether its attribute splatting forwards
                       @ondragover:preventDefault correctly to the rendered <td> - with no paired
                       @ondragover handler - isn't a guarantee Blazor makes for components the way it
                       does for elements. A native element sidesteps the question entirely. *@
                    <div draggable="true" @ondragstart="@(() => OnDragStart(context.Id))"
                         @ondragover:preventDefault="true" @ondrop="@(() => OnDropAsync(context.Id))"
                         style="cursor:grab; display:flex; align-items:center; width:100%; height:100%; margin:-16px; padding:16px;">
                        <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                    </div>
                </AuthorizeView>
            </MudTd>
            <MudTd>
                <div @ondragover:preventDefault="true" @ondrop="@(() => OnDropAsync(context.Id))"
                     style="width:100%; height:100%; margin:-16px; padding:16px;">@context.Name</div>
            </MudTd>
            <MudTd>
                <AuthorizeView Policy="DomainsEdit" Context="authState">
                    <Authorized>
                        <SearchableMultiSelect TValue="int" Options="_groupOptions" SelectedValues="context.GroupIds"
                                               SelectedValuesChanged="@(ids => SetDomainGroupsAsync(context, ids))"
                                               MultiSelectionTextFunc="@(selected => selected.Count == 0 ? "None" : $"{selected.Count} group(s)")" />
                    </Authorized>
                    <NotAuthorized>
                        @(_allGroups.Where(g => context.GroupIds.Contains(g.Id)).Select(g => g.Name).Any()
                            ? string.Join(", ", _allGroups.Where(g => context.GroupIds.Contains(g.Id)).Select(g => g.Name))
                            : "None")
                    </NotAuthorized>
                </AuthorizeView>
            </MudTd>
            <MudTd>
                <AuthorizeView Policy="DomainsEdit" Context="authState">
                    <Authorized>
                        <SearchableMultiSelect TValue="int" Options="_tagOptions" SelectedValues="context.TagIds"
                                               SelectedValuesChanged="@(ids => SetDomainTagsAsync(context, ids))"
                                               MultiSelectionTextFunc="@(selected => selected.Count == 0 ? "None" : $"{selected.Count} tag(s)")" />
                    </Authorized>
                    <NotAuthorized>
                        @(_allTags.Where(t => context.TagIds.Contains(t.Id)).Select(t => t.Name).Any()
                            ? string.Join(", ", _allTags.Where(t => context.TagIds.Contains(t.Id)).Select(t => t.Name))
                            : "None")
                    </NotAuthorized>
                </AuthorizeView>
            </MudTd>
            @foreach (var list in _psaLists)
            {
                <MudTd>
                    <PsaCompanyPicker Psa="list.Psa" Companies="list.Companies" Current="@context.Links.FirstOrDefault(link => link.Psa == list.Psa)"
                                      Placeholder="Use Group's" CompanyChanged="@(company => SetPsaCompanyAsync(context, list.Psa, company))" />
                </MudTd>
            }
            <MudTd>
                <AuthorizeView Policy="DomainsEdit" Context="authState">
                    <Authorized>
                        <MudSwitch T="bool" Value="context.IsMonitored" ValueChanged="@(v => SetMonitoredAsync(context, v))" Color="Color.Primary" />
                    </Authorized>
                    <NotAuthorized>
                        @(context.IsMonitored ? "Yes" : "No")
                    </NotAuthorized>
                </AuthorizeView>
            </MudTd>
            <MudTd>@context.ReportCount</MudTd>
            <MudTd>@(context.LastReportReceivedUtc is { } last ? DotMarc.Reporting.UkTime.DateTime(last) : "never")</MudTd>
            <MudTd>
                <AuthorizeView Policy="DomainsDelete" Context="authState">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteDomainAsync(context))" />
                </AuthorizeView>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<DomainRow>? _domains;
    private List<Group> _allGroups = [];
    private List<Tag> _allTags = [];
    private List<PsaCompanyList> _psaLists = [];

    // Built once per load rather than per row, since every row's pickers share them.
    private List<SelectOption<int>> _groupOptions = [];
    private List<SelectOption<int>> _tagOptions = [];
    private List<SelectOption<int?>> _groupFilterOptions = [];
    private List<SelectOption<int?>> _tagFilterOptions = [];
    private Dictionary<PsaKind, List<SelectOption<string>>> _companyFilterOptions = [];
    private string _newDomainName = "";
    private IReadOnlyCollection<int> _newDomainGroupIds = [];
    private string? _addError;

    // Limited to Groups: the page shows and changes only those Groups' domains, offers only those Groups, and hides
    // the PSA columns, whose company lists cover every client.
    private bool _isLimited;

    private async Task<DotMarc.Api.ApiScope> ScopeAsync() =>
        DotMarc.Api.ApiScope.From((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);

    /// <summary>The page only offers rows it loaded, but a change is checked against the scope again when it's made.</summary>
    private static Task<bool> MayChangeAsync(DotMarcDbContext db, DotMarc.Api.ApiScope scope, int domainId) =>
        scope.Domains(db.Domains.AsNoTracking()).AnyAsync(domain => domain.Id == domainId);

    private string? _domainFilter;
    private int? _groupFilter;
    private int? _tagFilter;
    private readonly Dictionary<PsaKind, string?> _companyFilters = [];
    private bool? _monitoredFilter;
    private int? _minReportCountFilter;
    private string? _lastReportFilter;
    private bool _showFilters;

    private bool RowMatchesFilters(DomainRow row)
    {
        if (!string.IsNullOrWhiteSpace(_domainFilter) && !row.Name.Contains(_domainFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (_groupFilter is { } groupId && !row.GroupIds.Contains(groupId))
        {
            return false;
        }
        if (_tagFilter is { } tagId && !row.TagIds.Contains(tagId))
        {
            return false;
        }
        foreach (var (psa, companyId) in _companyFilters)
        {
            if (companyId is not null && row.Links.FirstOrDefault(link => link.Psa == psa)?.CompanyId != companyId)
            {
                return false;
            }
        }
        if (_monitoredFilter is { } monitored && row.IsMonitored != monitored)
        {
            return false;
        }
        if (_minReportCountFilter is { } minReports && row.ReportCount < minReports)
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_lastReportFilter))
        {
            var text = row.LastReportReceivedUtc is { } last ? DotMarc.Reporting.UkTime.DateTime(last) : "never";
            if (!text.Contains(_lastReportFilter, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
        }
        return true;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var scope = await ScopeAsync();
        _isLimited = scope.IsScoped;
        await using var db = await DbFactory.CreateDbContextAsync();
        _allGroups = await scope.Groups(db.Groups.AsNoTracking()).OrderBy(g => g.Name).ToListAsync();
        _allTags = await db.Tags.AsNoTracking().OrderBy(t => t.Name).ToListAsync();
        _domains = await scope.Domains(db.Domains.AsNoTracking())
            // Several collections are projected, so without this EF joins them all into one result set.
            .AsSplitQuery()
            .OrderBy(d => d.SortOrder)
            .ThenBy(d => d.Name)
            .Select(d => new DomainRow(d.Id, d.Name, d.IsMonitored, d.Reports.Count, d.LastReportReceivedUtc,
                d.Groups.Select(g => g.Id).ToList(), d.Tags.Select(t => t.Id).ToList(), d.PsaCompanyLinks.ToList()))
            .ToListAsync();

        if (_isLimited)
        {
            _psaLists = [];
        }
        else
        {
            await using var psaDb = await DbFactory.CreateDbContextAsync();
            _psaLists = (await PsaDirectory.LoadAsync(psaDb)).ToList();
        }

        _groupOptions = _allGroups.Select(group => new SelectOption<int>(group.Id, group.Name)).ToList();
        _tagOptions = _allTags.Select(tag => new SelectOption<int>(tag.Id, tag.Name)).ToList();
        _groupFilterOptions = _allGroups.Select(group => new SelectOption<int?>(group.Id, group.Name)).ToList();
        _tagFilterOptions = _allTags.Select(tag => new SelectOption<int?>(tag.Id, tag.Name)).ToList();
        _companyFilterOptions = _psaLists.ToDictionary(
            list => list.Psa,
            list => (list.Companies ?? []).Select(company => new SelectOption<string>(company.Id, company.Name)).ToList());
    }

    private async Task AddDomainAsync()
    {
        _addError = null;
        var scope = await ScopeAsync();
        var groupIds = _newDomainGroupIds.Where(scope.Includes).ToList();
        if (scope.IsScoped && groupIds.Count == 0)
        {
            _addError = "Choose at least one of your groups for the domain.";
            return;
        }

        DomainManagementService.AddDomainResult result;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            result = await DomainManagementService.AddDomainAsync(db, await AuditActorAccessor.GetAsync(), _newDomainName, CancellationToken.None, groupIds);
        }
        catch (Exception)
        {
            _addError = "Something went wrong adding the domain. Try again.";
            return;
        }

        _addError = result switch
        {
            DomainManagementService.AddDomainResult.InvalidName => "Enter a valid domain name (e.g. contoso.example).",
            DomainManagementService.AddDomainResult.AlreadyMonitored => "That domain is already monitored.",
            _ => null
        };

        if (result == DomainManagementService.AddDomainResult.Added)
        {
            _newDomainName = "";
            _newDomainGroupIds = [];
            await LoadAsync();
        }
    }

    private async Task SetMonitoredAsync(DomainRow row, bool isMonitored)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await MayChangeAsync(db, await ScopeAsync(), row.Id))
            {
                await DomainManagementService.SetMonitoredAsync(db, await AuditActorAccessor.GetAsync(), row.Id, isMonitored, CancellationToken.None);
            }
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to update {row.Name}. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    private async Task SetDomainGroupsAsync(DomainRow row, IEnumerable<int> groupIds)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var scope = await ScopeAsync();
            if (!await MayChangeAsync(db, scope, row.Id))
            {
                return;
            }

            var result = await GroupManagementService.SetDomainGroupsWithinLimitAsync(db, await AuditActorAccessor.GetAsync(), row.Id, groupIds.ToList(), scope.GroupIds, CancellationToken.None);
            if (result == GroupManagementService.SetDomainGroupsResult.WouldLoseAccess)
            {
                Snackbar.Add($"{row.Name} has to stay in at least one of your groups, or you'd lose access to it.", Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to update {row.Name}'s groups. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    private async Task SetDomainTagsAsync(DomainRow row, IEnumerable<int> tagIds)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await MayChangeAsync(db, await ScopeAsync(), row.Id))
            {
                await TagManagementService.SetDomainTagsAsync(db, await AuditActorAccessor.GetAsync(), row.Id, tagIds.ToList(), CancellationToken.None);
            }
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to update {row.Name}'s tags. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    private async Task DeleteDomainAsync(DomainRow row)
    {
        var parameters = new DialogParameters<ConfirmDeleteDomainDialog>
        {
            { x => x.DomainName, row.Name },
            { x => x.ReportCount, row.ReportCount }
        };
        var dialogRef = await DialogService.ShowAsync<ConfirmDeleteDomainDialog>("Remove domain", parameters);
        var result = await dialogRef.Result;

        if (result is { Canceled: false })
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                if (await MayChangeAsync(db, await ScopeAsync(), row.Id))
                {
                    await DomainManagementService.RemoveDomainAsync(db, await AuditActorAccessor.GetAsync(), row.Id, CancellationToken.None);
                }
                await LoadAsync();
            }
            catch (Exception)
            {
                // Leave the row in place - don't optimistically remove it from _domains before
                // the delete has actually succeeded.
                Snackbar.Add($"Failed to remove {row.Name}. Try again.", Severity.Error);
            }
        }
    }

    private int? _draggedDomainId;

    private void OnDragStart(int domainId) => _draggedDomainId = domainId;

    private async Task OnDropAsync(int targetDomainId)
    {
        if (_domains is null || _draggedDomainId is null || _draggedDomainId == targetDomainId)
        {
            _draggedDomainId = null;
            return;
        }

        var draggedIndex = _domains.FindIndex(d => d.Id == _draggedDomainId);
        var targetIndex = _domains.FindIndex(d => d.Id == targetDomainId);
        _draggedDomainId = null;

        if (draggedIndex < 0 || targetIndex < 0)
        {
            return;
        }

        var moved = _domains[draggedIndex];
        _domains.RemoveAt(draggedIndex);
        _domains.Insert(targetIndex, moved);

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await DomainManagementService.ReorderAsync(db, await AuditActorAccessor.GetAsync(), _domains.Select(d => d.Id).ToList(), CancellationToken.None);
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to save the new order. Try again.", Severity.Error);
        }

        await LoadAsync();
    }

    private async Task SetPsaCompanyAsync(DomainRow row, PsaKind psa, PsaCompany? company)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (_isLimited || !await MayChangeAsync(db, await ScopeAsync(), row.Id))
            {
                return;
            }

            await DomainManagementService.SetPsaCompanyAsync(db, await AuditActorAccessor.GetAsync(), row.Id, psa, company, CancellationToken.None);
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to update {row.Name}'s {psa.CompanyLabel()}. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    private sealed record DomainRow(int Id, string Name, bool IsMonitored, int ReportCount, DateTimeOffset? LastReportReceivedUtc, List<int> GroupIds, List<int> TagIds, List<PsaCompanyLink> Links);
}

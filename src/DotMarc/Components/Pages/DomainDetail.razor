    /// PollingService.RunSingleDmarcCheckAsync's remarks) so this can never drift from what the
    /// scheduled check actually does.</summary>
    private async Task RecheckDmarcAsync()
    {
        _isRecheckingDmarc = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            _domain!.DmarcCheckStatus = domain.DmarcCheckStatus;
            _domain.DmarcCheckedUtc = domain.DmarcCheckedUtc;
            _domain.DmarcCheckDetail = domain.DmarcCheckDetail;
        }
        finally
        {
            _isRecheckingDmarc = false;
        }
    }


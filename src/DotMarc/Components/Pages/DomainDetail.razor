@page "/domains/{DomainName}"
@page "/domains/{DomainName}/{Tab}"
@attribute [Authorize(Policy = "DomainsView")]
@using DotMarc.Data
@using DotMarc.Reporting
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using DotMarc.IpEnrichment
@using DotMarc.DnsPush
@using DotMarc.Dns
@using DotMarc.Graph
@using DotMarc.Ingestion
@using DotMarc.Components.Dialogs
@using DotMarc.Components.Shared
@using DotMarc.Notifications
@using DotMarc.Senders
@using DotMarc.Enforcement
@inject AuditActorAccessor AuditActorAccessor
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject IIpInfoLookup IpLookup
@inject IReverseDnsLookup ReverseDnsLookup
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ILogger<DomainDetail> Logger
@inject IDnsProviderDetector DnsProviderDetector
@inject IEnumerable<IDnsPushProvider> DnsPushProviders
@inject IDmarcTxtLookup DmarcTxtLookup
@inject ITlsrptTxtLookup TlsrptTxtLookup
@inject IDmarcAuthorizationTxtLookup DmarcAuthorizationTxtLookup
@inject IDmarcDnsChecker DmarcDnsChecker
@inject ITlsrptDnsChecker TlsrptDnsChecker
@inject ISpfDnsChecker SpfDnsChecker
@inject IMxDnsChecker MxDnsChecker
@inject IDanglingCnameChecker DanglingCnameChecker
@inject ICertificateChecker CertificateChecker
@inject IDomainExpiryChecker DomainExpiryChecker
@inject DotMarc.Lookalikes.ILookalikeChecker LookalikeChecker
@inject IBlocklistChecker BlocklistChecker
@inject IDkimDnsChecker DkimDnsChecker
@inject IMailServiceDetector MailServiceDetector
@inject ITxtRecordLookup TxtRecordLookup
@inject ICnameLookup CnameLookup
@inject IEnumerable<IDnsChangeBuilder> ChangeBuilders
@inject IOptions<GraphOptions> GraphOptions
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>dotMARC - @DomainName</PageTitle>
<MudButton Href="/dashboard" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">Back</MudButton>
<div class="d-flex align-center flex-wrap mb-4" style="gap:12px">
    <MudText Typo="Typo.h4">@DomainName</MudText>
    @if (_score is not null)
    {
        <DotMarc.Components.Shared.ScoreChip Domain="_score" />
    }
</div>
@if (_clientManagesDns)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">@_noPushReason When a record needs changing, dotMARC shows it with a copy button to send to them.</MudAlert>
}
@if (_domain is not null && _domain.DnsProvider.ToProviderKey() is not null)
{
    <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
        DNS: @DnsProviderStatusPresentation.GetLabel(_domain.DnsProvider) (@_domain.DnsZone)
    </MudText>
}

@if (_domain is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTabs ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="OnActiveTabIndexChangedAsync">
        <MudTabPanel Text="Overview">
            <MudGrid Class="my-2">
                <MudItem xs="4"><MudText>Pass rate (30d): <b>@(_passRate is { } r ? r.ToString("P1") : "—")</b></MudText></MudItem>
                <MudItem xs="4"><MudText>Volume (30d): <b>@_totalVolume</b></MudText></MudItem>
                <MudItem xs="4"><MudText>Sources: <b>@_sourceCount</b></MudText></MudItem>
            </MudGrid>
            <MudText Typo="Typo.subtitle2" Class="mt-2">Messages a day, by what receivers did with them (30 days to yesterday)</MudText>
            <MudChart ChartType="ChartType.Line" ChartSeries="@_series" ChartLabels="@_xAxisLabels" ChartOptions="@_chartOptions" Width="100%" Height="260px" />
            @if (_reasonBreakdown is { Total: > 0 } breakdown)
            {
                <MudPaper Class="pa-4 mt-4" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Why rejects/quarantines happened (30d)</MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="5">
                            <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@([_reasonData])" ChartLabels="@_reasonLabels" Width="220px" Height="220px" />
                        </MudItem>
                        <MudItem xs="12" sm="7" Class="d-flex align-center">
                            <ReasonBreakdownList Breakdown="breakdown" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.subtitle1">Domain health</MudText>
                    <DocsLink Href="https://dotmarc.app/docs/scope" Text="What dotMARC monitors for a domain" Class="ml-2" />
                </div>
                @if (_detectedMailServices.Count > 0)
                {
                    <div class="d-flex align-center flex-wrap mb-3" style="gap:6px;">
                        @foreach (var service in _detectedMailServices)
                        {
                            <MudChip T="string"
                                     Color="@(service.Kind == DetectedMailServiceKind.Inbox ? Color.Primary : Color.Secondary)"
                                     Size="Size.Small"
                                     Icon="@(service.Kind == DetectedMailServiceKind.Inbox ? Icons.Material.Filled.Inbox : Icons.Material.Filled.Send)">
                                @service.ProviderName
                            </MudChip>
                        }
                    </div>
                }

                <DomainHealthCheckRow Title="DMARC record" Hint="The _dmarc TXT record: tells receivers what to do with mail that fails DMARC, and where to send reports."
                                      StatusColor="@DmarcStatusPresentation.GetColor(_domain.DmarcCheckStatus)"
                                      StatusLabel="@DmarcStatusPresentation.GetLabel(_domain.DmarcCheckStatus)"
                                      CheckedUtc="_domain.DmarcCheckedUtc"
                                      Detail="@_domain.DmarcCheckDetail">
                    <ActionContent>
                        <AuthorizeView Policy="DomainsEdit" Context="dmarcRecheckAuthState">
                            <Authorized>
                                @if (_isRecheckingDmarc)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RecheckDmarcAsync" title="Recheck now" />
                                }
                                @if ((_domain.DmarcCheckStatus is DmarcCheckStatus.MissingOwnRecord or DmarcCheckStatus.Misconfigured) && !_canPushDomainZone)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => ShowRecordsAsync("dmarc", "DMARC record"))">Show record to add</MudButton>
                                }
                                else if (_domain.DmarcCheckStatus is DmarcCheckStatus.MissingOwnRecord or DmarcCheckStatus.Misconfigured)
                                {
                                    @if (_isPushingDmarcRecord)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudSync"
                                                   OnClick="PushDmarcRecordAsync">Push via your DNS provider</MudButton>
                                    }
                                }
                            </Authorized>
                        </AuthorizeView>
                    </ActionContent>
                </DomainHealthCheckRow>

                @if (_enforcement is { } enforcement)
                {
                    var nextName = enforcement.NextPolicy is { } next ? next.ToString().ToLowerInvariant() : null;
                    <DomainHealthCheckRow Title="DMARC enforcement" Hint="How far the domain is from blocking spoofed mail (p=reject), and what's in the way."
                                          StatusColor="@(enforcement.Enforced ? Color.Success : enforcement.Ready ? Color.Info : enforcement.Stage == EnforcementStage.NoRecord ? Color.Error : Color.Warning)"
                                          StatusLabel="@EnforcementReadiness.Describe(enforcement.Stage)"
                                          CheckedUtc="_domain.DmarcCheckedUtc"
                                          Detail="@EnforcementSummary(enforcement)">
                        <ActionContent>
                            @if (enforcement.Blockers.Count > 0)
                            {
                                <MudTooltip>
                                    <ChildContent><MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Style="cursor:help" /></ChildContent>
                                    <TooltipContent>
                                        @foreach (var blocker in enforcement.Blockers)
                                        {
                                            <div style="max-width:420px; text-align:left" class="my-1"><b>@blocker.Title.</b> @blocker.Detail</div>
                                        }
                                    </TooltipContent>
                                </MudTooltip>
                            }
                            @* The next step's record only once the domain is ready for it: pushed where dotMARC can, shown to
                               add by hand where it can't. Until then the tooltip says what's in the way. *@
                            @if (nextName is not null && enforcement.Ready)
                            {
                                <AuthorizeView Policy="DomainsEdit" Context="enforcementAuthState">
                                    @if (_canPushDomainZone)
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.CloudSync" OnClick="@(() => PushPolicyAsync(enforcement.NextPolicy!.Value))">Move to p=@nextName</MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy"
                                                   OnClick="@(() => ShowRecordsAsync("dmarc-policy", $"DMARC record for p={nextName}", nextName))">Show p=@nextName record</MudButton>
                                    }
                                </AuthorizeView>
                            }
                            <MudLink Href="/enforcement" Typo="Typo.body2">All domains</MudLink>
                        </ActionContent>
                    </DomainHealthCheckRow>
                }

                <DomainHealthCheckRow Title="DMARC authorization record" Hint="A record in your reporting mailbox's domain that lets receivers send this domain's reports there. Without it some receivers won't."
                                      StatusColor="@DmarcAuthorizationStatusPresentation.GetColor(_domain.DmarcAuthorizationCheckStatus)"
                                      StatusLabel="@DmarcAuthorizationStatusPresentation.GetLabel(_domain.DmarcAuthorizationCheckStatus)"
                                      CheckedUtc="_domain.DmarcAuthorizationCheckedUtc"
                                      Detail="@_domain.DmarcAuthorizationCheckDetail">
                    <ActionContent>
                        <AuthorizeView Policy="DomainsEdit" Context="dmarcAuthRecheckAuthState">
                            <Authorized>
                                @if (_isRecheckingDmarcAuth)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RecheckDmarcAuthorizationAsync" title="Recheck now" />
                                }
                                @* The record lives in the reports mailbox's domain, not this one, so both buttons say so: the
                                   record to add is always there, and a push where that domain's DNS can take one. *@
                                @if (_domain.DmarcAuthorizationCheckStatus == DmarcAuthorizationCheckStatus.Missing)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => ShowRecordsAsync("dmarc-auth", $"DMARC authorization record (in {MailboxDomain}'s DNS)"))">Show record to add</MudButton>
                                    @if (_isPushingDmarcAuthRecord)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                    else if (_canPushMailboxZone)
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudSync"
                                                   OnClick="PushDmarcAuthorizationRecordAsync">Push to @MailboxDomain</MudButton>
                                    }
                                }
                            </Authorized>
                        </AuthorizeView>
                    </ActionContent>
                </DomainHealthCheckRow>

                @if (!string.IsNullOrWhiteSpace(GraphOptions.Value.TlsReportingAddress))
                {
                    <DomainHealthCheckRow Title="TLS reporting record" Hint="The _smtp._tls record: asks senders to report problems delivering to the domain over encryption."
                                          StatusColor="@TlsrptStatusPresentation.GetColor(_domain.TlsrptCheckStatus)"
                                          StatusLabel="@TlsrptStatusPresentation.GetLabel(_domain.TlsrptCheckStatus)"
                                          CheckedUtc="_domain.TlsrptCheckedUtc"
                                          Detail="@_domain.TlsrptCheckDetail">
                        <ActionContent>
                            <AuthorizeView Policy="DomainsEdit" Context="tlsrptRecheckAuthState">
                                <Authorized>
                                    @if (_isRecheckingTlsrpt)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RecheckTlsrptAsync" title="Recheck now" />
                                    }
                                    @if ((_domain.TlsrptCheckStatus is TlsrptCheckStatus.MissingOwnRecord or TlsrptCheckStatus.Misconfigured) && !_canPushDomainZone)
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => ShowRecordsAsync("tlsrpt", "TLS reporting record"))">Show record to add</MudButton>
                                    }
                                    else if (_domain.TlsrptCheckStatus is TlsrptCheckStatus.MissingOwnRecord or TlsrptCheckStatus.Misconfigured)
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudSync"
                                                   OnClick="PushTlsrptRecordAsync">Push via your DNS provider</MudButton>
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </ActionContent>
                    </DomainHealthCheckRow>
                }

                <DomainHealthCheckRow Title="MTA-STS" Hint="Tells senders to deliver to the domain only over encrypted, verified connections, so mail can't be intercepted."
                                      StatusColor="@MtaStsStatusPresentation.GetColor(_domain.MtaStsStatus, _domain.MtaStsMode)"
                                      StatusLabel="@MtaStsStatusPresentation.GetLabel(_domain.MtaStsStatus, _domain.MtaStsMode)"
                                      CheckedUtc="_domain.MtaStsCheckedUtc"
                                      Detail="@_domain.MtaStsCheckDetail">
                    <ActionContent>
                        <MudLink OnClick="@(() => NavigateToTabAsync("mta-sts"))" Style="cursor:pointer">View details</MudLink>
                    </ActionContent>
                </DomainHealthCheckRow>

                <DomainHealthCheckRow Title="SPF" Hint="The list of servers allowed to send mail as the domain."
                                      StatusColor="@SpfStatusPresentation.GetColor(_domain.SpfCheckStatus)"
                                      StatusLabel="@SpfStatusPresentation.GetLabel(_domain.SpfCheckStatus)"
                                      CheckedUtc="_domain.SpfCheckedUtc"
                                      Detail="@_domain.SpfCheckDetail">
                    <ActionContent>
                        <AuthorizeView Policy="DomainsEdit" Context="spfRecheckAuthState">
                            <Authorized>
                                @if (_isRecheckingSpf)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RecheckSpfAsync" title="Recheck now" />
                                }
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditSpfAsync">Edit SPF</MudButton>
                            </Authorized>
                        </AuthorizeView>
                    </ActionContent>
                    <Below>
                        @if (_returnPaths.Count > 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Mail services sending for this domain use their own bounce subdomains, so receivers check SPF there instead:
                            </MudText>
                            @foreach (var returnPath in _returnPaths)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    <code>@returnPath.Domain.Name</code>
                                    @if (returnPath.Cname is { } cname)
                                    {
                                        <span> → <code>@cname</code></span>
                                    }
                                    @if (ReturnPathSender(returnPath) is { } sender)
                                    {
                                        <span> (@sender)</span>
                                    }
                                    <span>: @returnPath.Domain.Volume.ToString("N0") message@(returnPath.Domain.Volume == 1 ? "" : "s"), </span>
                                    <MudText Typo="Typo.body2" Inline="true" Color="@(returnPath.Domain.PassRate >= 0.98 ? Color.Success : Color.Warning)">@returnPath.Domain.PassRate.ToString("P0") passing SPF</MudText>
                                </MudText>
                            }
                            @if (_domain.SpfCheckStatus == SpfCheckStatus.MissingRecord)
                            {
                                <MudText Typo="Typo.body2" Class="mt-1">
                                    That mail passes SPF through those subdomains, but @_domain.Name itself still needs an SPF record, or anyone can use it as a bounce address. Add one with Edit SPF, listing the services that send as it.
                                </MudText>
                            }
                        }
                    </Below>
                </DomainHealthCheckRow>

                <DomainHealthCheckRow Title="MX" Hint="The mail servers that receive the domain's email."
                                      StatusColor="@MxStatusPresentation.GetColor(_domain.MxCheckStatus)"
                                      StatusLabel="@MxStatusPresentation.GetLabel(_domain.MxCheckStatus)"
                                      CheckedUtc="_domain.MxCheckedUtc"
                                      Detail="@_domain.MxCheckDetail">
                    <ActionContent>
                        <AuthorizeView Policy="DomainsEdit" Context="mxRecheckAuthState">
                            <Authorized>
                                @if (_isRecheckingMx)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RecheckMxAsync" title="Recheck now" />
                                }
                            </Authorized>
                        </AuthorizeView>
                    </ActionContent>
                </DomainHealthCheckRow>

                @if (_domain.IsMonitored)
                {
                    <DomainHealthCheckRow Title="Dangling CNAME" Hint="Common subdomains pointing at names that no longer exist, which someone could claim to take the subdomain over."
                                          StatusColor="@DanglingCnameStatusPresentation.GetColor(_domain.DanglingCnameStatus)"
                                          StatusLabel="@DanglingCnameStatusPresentation.GetLabel(_domain.DanglingCnameStatus)"
                                          CheckedUtc="_domain.DanglingCnameCheckedUtc"
                                          Detail="@_domain.DanglingCnameDetail">
                        <ActionContent>
                            <AuthorizeView Policy="DomainsEdit" Context="danglingCnameRecheckAuthState">
                                <Authorized>
                                    @if (_isRecheckingDanglingCname)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RecheckDanglingCnameAsync" title="Recheck now" />
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </ActionContent>
                    </DomainHealthCheckRow>

                    <DomainHealthCheckRow Title="Website certificates" Hint="The HTTPS certificates on the domain, www and mta-sts. Expired or wrong ones show visitors a browser warning."
                                          StatusColor="@CertificateStatusPresentation.GetColor(_domain.CertificateStatus)"
                                          StatusLabel="@CertificateStatusPresentation.GetLabel(_domain.CertificateStatus)"
                                          CheckedUtc="_domain.CertificateCheckedUtc"
                                          Detail="@_domain.CertificateDetail">
                        <ActionContent>
                            <AuthorizeView Policy="DomainsEdit" Context="certificateRecheckAuthState">
                                <Authorized>
                                    @if (_isRecheckingCertificate)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RecheckCertificateAsync" title="Recheck now" />
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </ActionContent>
                    </DomainHealthCheckRow>

                    <DomainHealthCheckRow Title="Domain registration" Hint="When the domain's registration expires, from the registry. If it lapses, the domain's mail and website stop."
                                          StatusColor="@DomainExpiryStatusPresentation.GetColor(_domain.DomainExpiryStatus)"
                                          StatusLabel="@DomainExpiryStatusPresentation.GetLabel(_domain.DomainExpiryStatus)"
                                          CheckedUtc="_domain.DomainExpiryCheckedUtc"
                                          Detail="@_domain.DomainExpiryDetail">
                        <ActionContent>
                            <AuthorizeView Policy="DomainsEdit" Context="domainExpiryRecheckAuthState">
                                <Authorized>
                                    @if (_isRecheckingDomainExpiry)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RecheckDomainExpiryAsync" title="Recheck now" />
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </ActionContent>
                    </DomainHealthCheckRow>

                    <DomainHealthCheckRow Title="Lookalike domains" Hint="Registered typo and look-alike versions of the domain, such as a letter swapped or .com for .co.uk. One set up for mail is how invoice fraud usually starts. Checked weekly."
                                          StatusColor="@LookalikeStatusPresentation.GetColor(_domain.LookalikeStatus)"
                                          StatusLabel="@LookalikeStatusPresentation.GetLabel(_domain.LookalikeStatus)"
                                          CheckedUtc="_domain.LookalikeCheckedUtc"
                                          Detail="@_domain.LookalikeDetail">
                        <ActionContent>
                            @if (_lookalikes.Count > 0)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _showLookalikes = !_showLookalikes">
                                    @(_showLookalikes ? "Hide" : $"View ({_lookalikes.Count})")
                                </MudButton>
                            }
                            <AuthorizeView Policy="DomainsEdit" Context="lookalikeRecheckAuthState">
                                <Authorized>
                                    @if (_isRecheckingLookalikes)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RecheckLookalikesAsync" title="Recheck now" />
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </ActionContent>
                        <Below>
                            @if (_showLookalikes && _lookalikes.Count > 0)
                            {
                                <MudSimpleTable Dense="true" Hover="true" Class="mt-1">
                                    <thead>
                                        <tr>
                                            <th>Domain</th>
                                            <th><Hint Text="How it differs from the real domain.">Kind</Hint></th>
                                            <th><Hint Text="Whether it has MX records, so it can send convincing mail and receive replies.">Mail</Hint></th>
                                            <th>First seen</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var lookalike in _lookalikes)
                                        {
                                            <tr style="@(lookalike.Dismissed ? "opacity:0.55;" : "")">
                                                <td>@lookalike.Name</td>
                                                <td>@lookalike.Kind</td>
                                                <td>
                                                    @if (lookalike.HasMx)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="@(lookalike.Dismissed ? Color.Default : Color.Error)">Can receive mail</MudChip>
                                                    }
                                                    else
                                                    {
                                                        <span>No</span>
                                                    }
                                                </td>
                                                <td>@UkTime.Date(lookalike.FirstSeenUtc)</td>
                                                <td>
                                                    <AuthorizeView Policy="DomainsEdit" Context="lookalikeDismissAuthState">
                                                        <Authorized>
                                                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => SetLookalikeDismissedAsync(lookalike.Id, !lookalike.Dismissed)">
                                                                @(lookalike.Dismissed ? "Restore" : "Dismiss")
                                                            </MudButton>
                                                        </Authorized>
                                                    </AuthorizeView>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        </Below>
                    </DomainHealthCheckRow>

                    <DomainHealthCheckRow Title="Blocklists" Hint="Whether the IP addresses the domain sends from (in its SPF record or approved on Sources) or receives mail at are on the main spam blocklists. A listed server's mail goes to spam or bounces. Big providers' servers are skipped."
                                          StatusColor="@BlocklistStatusPresentation.GetColor(_domain.BlocklistStatus)"
                                          StatusLabel="@BlocklistStatusPresentation.GetLabel(_domain.BlocklistStatus)"
                                          CheckedUtc="_domain.BlocklistCheckedUtc"
                                          Detail="@_domain.BlocklistDetail">
                        <ActionContent>
                            <AuthorizeView Policy="DomainsEdit" Context="blocklistRecheckAuthState">
                                <Authorized>
                                    @if (_isRecheckingBlocklist)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RecheckBlocklistAsync" title="Recheck now" />
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </ActionContent>
                    </DomainHealthCheckRow>
                }

                <DomainHealthCheckRow Title="DKIM" Hint="The public keys receivers use to check the domain's email signatures."
                                      StatusColor="@DkimStatusPresentation.GetColor(_domain.DkimCheckStatus)"
                                      StatusLabel="@DkimStatusPresentation.GetLabel(_domain.DkimCheckStatus)"
                                      CheckedUtc="_domain.DkimCheckedUtc"
                                      Detail="@_domain.DkimCheckDetail">
                    <ActionContent>
                        <AuthorizeView Policy="DomainsEdit" Context="dkimAuthState">
                            <Authorized>
                                @if (_isRecheckingDkim)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else if (_domain.DkimSelectors.Count > 0)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RecheckDkimAsync" title="Recheck now" />
                                }
                                @if (_domain.DkimRecords.Count > 0 && _domain.DkimCheckStatus is DkimCheckStatus.Missing or DkimCheckStatus.Misconfigured)
                                {
                                    @if (_canPushDomainZone)
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudSync" OnClick="PushDkimRecordsAsync">Push DKIM records</MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => ShowRecordsAsync("dkim", "DKIM records"))">Show records to add</MudButton>
                                    }
                                }
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenDkimSelectorsDialogAsync">Configure selectors</MudButton>
                            </Authorized>
                        </AuthorizeView>
                    </ActionContent>
                </DomainHealthCheckRow>

                <DomainHealthCheckRow Title="DNS provider" Hint="Who hosts the domain's DNS, and whether dotMARC can push records there."
                                      StatusColor="@DnsProviderStatusPresentation.GetColor(_domain.DnsProvider)"
                                      StatusLabel="@DnsProviderStatusPresentation.GetLabel(_domain.DnsProvider)"
                                      CheckedUtc="_domain.DnsProviderCheckedUtc"
                                      Detail="@(_domain.DnsZone is { } zone ? $"Zone: {zone}" : null)">
                    <ActionContent>
                        @if (_domain.DnsNameservers.Count > 0)
                        {
                            <MudTooltip Text="@string.Join(", ", _domain.DnsNameservers)" Arrow="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" title="Configured nameservers" />
                            </MudTooltip>
                        }
                        <AuthorizeView Policy="DomainsEdit" Context="dnsProviderAuthState">
                            <Authorized>
                                @if (_isRecheckingDnsProvider)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RecheckDnsProviderAsync" title="Recheck now" />
                                }
                            </Authorized>
                        </AuthorizeView>
                    </ActionContent>
                </DomainHealthCheckRow>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="MTA-STS">
            <AuthorizeView Policy="MtaStsView" Context="viewAuthState">
                <DomainMtaStsPanel Domain="_domain" OpenDnsPushPopup="OpenDnsPushPopupAsync" MayPush="_canPushDomainZone" />
            </AuthorizeView>
        </MudTabPanel>

        <MudTabPanel Text="TLS reports">
            <div class="d-flex align-center mb-2">
                <MudText Typo="Typo.subtitle1">TLS delivery reports</MudText>
                <DocsLink Href="https://dotmarc.app/docs/mta-sts#tls-reporting" Text="How TLS reporting works" Class="ml-2" />
            </div>
            @if (_tlsrptReports.Count == 0)
            {
                <MudText Class="my-4">No TLS reports received yet.</MudText>
            }
            else
            {
                <MudTable Items="_tlsrptReports" Hover="true" T="TlsrptReport" CustomHeader="true" Filter="TlsrptReportMatchesFilters">
                    <ToolBarContent>
                        <MudSpacer />
                        <MudButton Variant="@(_showTlsrptFilters ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList"
                                   OnClick="@(() => _showTlsrptFilters = !_showTlsrptFilters)">@(_showTlsrptFilters ? "Hide filters" : "Filters")</MudButton>
                    </ToolBarContent>
                    <HeaderContent>
                        <tr>
                            <MudTh><MudTableSortLabel SortBy="new Func<TlsrptReport, object>(r => r.ReportingOrg)"><Hint Text="The organisation that sent the report, such as Google or Microsoft.">From</Hint></MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<TlsrptReport, object>(r => r.DateRangeBeginUtc)"><Hint Text="The period the report covers, usually one day.">Date range</Hint></MudTableSortLabel></MudTh>
                            <MudTh><Hint Text="What the sender checked against: sts (the domain's MTA-STS policy) or no-policy-found (it hadn't the policy yet, so it used plain encryption).">Policy</Hint></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<TlsrptReport, object>(r => r.Policies.Sum(policy => policy.SuccessfulSessionCount))"><Hint Text="Connections to the domain's mail servers that were encrypted and passed the policy.">Successful sessions</Hint></MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<TlsrptReport, object>(r => r.Policies.Sum(policy => policy.FailedSessionCount))"><Hint Text="Connections that failed: a certificate, encryption or policy problem. Once MTA-STS enforces, these are refused.">Failed sessions</Hint></MudTableSortLabel></MudTh>
                            <MudTh><Hint Text="Why the failed connections failed, as the sender reported it.">Failure details</Hint></MudTh>
                        </tr>
                        @if (_showTlsrptFilters)
                        {
                        <tr>
                            <MudTh><MudTextField T="string" @bind-Value="_tlsrptFromFilter" Placeholder="Search" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" /></MudTh>
                            <MudTh><MudTextField T="string" @bind-Value="_tlsrptDateRangeFilter" Placeholder="Search" Immediate="true" Margin="Margin.Dense" /></MudTh>
                            <MudTh><MudTextField T="string" @bind-Value="_tlsrptPolicyFilter" Placeholder="Search" Immediate="true" Margin="Margin.Dense" /></MudTh>
                            <MudTh></MudTh>
                            <MudTh>
                                <MudSelect T="bool?" Value="_tlsrptHasFailuresFilter" ValueChanged="@(v => _tlsrptHasFailuresFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                                    <MudSelectItem T="bool?" Value="true">Some failed</MudSelectItem>
                                    <MudSelectItem T="bool?" Value="false">None failed</MudSelectItem>
                                </MudSelect>
                            </MudTh>
                            <MudTh><MudTextField T="string" @bind-Value="_tlsrptFailureDetailFilter" Placeholder="Search" Immediate="true" Margin="Margin.Dense" /></MudTh>
                        </tr>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.ReportingOrg</MudTd>
                        <MudTd>@FormatDateRange(context.DateRangeBeginUtc, context.DateRangeEndUtc)</MudTd>
                        <MudTd>@TlsrptPolicySummary(context)</MudTd>
                        <MudTd>@context.Policies.Sum(policy => policy.SuccessfulSessionCount)</MudTd>
                        <MudTd>@context.Policies.Sum(policy => policy.FailedSessionCount)</MudTd>
                        <MudTd>@TlsrptFailureSummary(context)</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <MudTabPanel Text="Sources">
            <MudTable Items="_sources" Hover="true" T="SourceRow" CustomHeader="true" Filter="SourceMatchesFilters">
                <ToolBarContent>
                    @{ var unreviewed = _sources.Select(s => s.Identity).DistinctBy(identity => identity.Key).Count(identity => !_senderApprovals.ContainsKey(identity.Key) && !identity.IsForwarder); }
                    @if (_senderApprovals.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Approve the services and servers that send this domain's mail, and dotMARC alerts you when anything else starts passing DMARC.</MudText>
                    }
                    else if (unreviewed > 0)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" OnClick="@(() => { _showSourceFilters = true; _sourceApprovalFilter = UnreviewedFilter; })">@unreviewed unreviewed sender@(unreviewed == 1 ? "" : "s")</MudChip>
                    }
                    <MudSpacer />
                    <MudButton Variant="@(_showSourceFilters ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList"
                               OnClick="@(() => _showSourceFilters = !_showSourceFilters)">@(_showSourceFilters ? "Hide filters" : "Filters")</MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <tr>
                        <MudTh><MudTableSortLabel SortBy="new Func<SourceRow, object>(s => s.HostName ?? s.SourceIp)"><Hint Text="The server that sent mail as this domain: its name where it has one, otherwise its IP address, then who the address is registered to and its country. Recognised services such as Microsoft 365 are named.">Source</Hint></MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<SourceRow, object>(s => ApprovalLabel(s))"><Hint Text="Approved: the domain's own mail. Not ours: spoofing, or forwarding you've checked. Forwarder: a known forwarding service, nothing to do. Unreviewed: nobody has looked yet.">Approval</Hint></MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<SourceRow, object>(s => s.Volume)"><Hint Text="Messages from this source in the last 30 days, as receivers reported them.">Volume</Hint></MudTableSortLabel></MudTh>
                        <MudTh><Hint Text="Messages a day from this source over the last 7 days.">7d trend</Hint></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<SourceRow, object>(s => s.FirstSeenUtc ?? DateTimeOffset.MinValue)"><Hint Text="When this source first appeared in a report for this domain.">First seen</Hint></MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<SourceRow, object>(s => s.SpfResult)"><Hint Text="Whether SPF passed: the sending server is listed in the domain's SPF record. Forwarding always breaks SPF, so a fail here isn't always a problem.">SPF</Hint></MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<SourceRow, object>(s => s.DkimResult)"><Hint Text="Whether DKIM passed: the message carried a valid signature from the domain. Signatures survive forwarding.">DKIM</Hint></MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<SourceRow, object>(s => s.Disposition)"><Hint Text="What the receiving server did with the mail: none (delivered), quarantine (junk) or reject (refused). Beneath it, why the receiver didn't follow the DMARC policy, when it says: forwarded, mailing list, local policy and so on.">Disposition</Hint></MudTableSortLabel></MudTh>
                    </tr>
                    @if (_showSourceFilters)
                    {
                    <tr>
                        <MudTh><MudTextField T="string" @bind-Value="_sourceIpFilter" Placeholder="Name, IP, owner, country" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" /></MudTh>
                        <MudTh>
                            <MudSelect T="string" Value="_sourceApprovalFilter" ValueChanged="@(v => _sourceApprovalFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                                <MudSelectItem T="string" Value="@("Approved")">Approved</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Not ours")">Not ours</MudSelectItem>
                                <MudSelectItem T="string" Value="@UnreviewedFilter">Unreviewed</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Forwarder")">Forwarder</MudSelectItem>
                            </MudSelect>
                        </MudTh>
                        <MudTh><MudNumericField T="int?" @bind-Value="_sourceMinVolumeFilter" Placeholder="Min" Margin="Margin.Dense" Min="0" /></MudTh>
                        <MudTh></MudTh>
                        <MudTh>
                            <MudSelect T="bool?" Value="_sourceIsNewFilter" ValueChanged="@(v => _sourceIsNewFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                                <MudSelectItem T="bool?" Value="true">New</MudSelectItem>
                                <MudSelectItem T="bool?" Value="false">Seen before</MudSelectItem>
                            </MudSelect>
                        </MudTh>
                        <MudTh>
                            <MudSelect T="string" Value="_sourceSpfFilter" ValueChanged="@(v => _sourceSpfFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                                @foreach (var result in _sources.Select(s => s.SpfResult).Distinct().OrderBy(r => r))
                                {
                                    <MudSelectItem T="string" Value="result">@result</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTh>
                        <MudTh>
                            <MudSelect T="string" Value="_sourceDkimFilter" ValueChanged="@(v => _sourceDkimFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                                @foreach (var result in _sources.Select(s => s.DkimResult).Distinct().OrderBy(r => r))
                                {
                                    <MudSelectItem T="string" Value="result">@result</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTh>
                        <MudTh>
                            <MudSelect T="string" Value="_sourceDispositionFilter" ValueChanged="@(v => _sourceDispositionFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                                @foreach (var disposition in _sources.Select(s => s.Disposition).Distinct().OrderBy(d => d))
                                {
                                    <MudSelectItem T="string" Value="disposition">@disposition</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField T="string" @bind-Value="_sourceReasonFilter" Placeholder="Reason" Immediate="true" Margin="Margin.Dense" />
                        </MudTh>
                    </tr>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="max-width:300px; overflow-wrap:anywhere;">
                        @* The name first, since it says who sent the mail; the IP stays beneath it, as SPF needs it. *@
                        @if (context.Identity.IsService)
                        {
                            <div><b>@context.Identity.Label</b></div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@(context.HostName ?? context.Organization) · @context.SourceIp</MudText>
                        }
                        else if (context.HostName is { } hostName)
                        {
                            <div>@hostName</div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.SourceIp</MudText>
                        }
                        else
                        {
                            <div>@context.SourceIp</div>
                            @if (context.IsHostNamePending)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Looking up name…</MudText>
                            }
                        }
                        @* Owner and country here rather than in columns of their own, so the table fits a laptop screen. *@
                        @if (context.IsEnrichmentPending)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Looking up owner…</MudText>
                        }
                        else if (OwnerLine(context) is { } owner)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@owner</MudText>
                        }
                    </MudTd>
                    <MudTd>
                        @{ var identity = context.Identity; var status = ApprovalStatus(context); }
                        <div class="d-flex align-center" style="gap:4px;">
                            <MudTooltip Text="@ApprovalTooltip(identity)" Arrow="true">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="@(status switch { SenderApprovalStatus.Approved => Color.Success, SenderApprovalStatus.NotOurs => Color.Error, _ => identity.IsForwarder ? Color.Info : Color.Default })">@ApprovalLabel(context)</MudChip>
                            </MudTooltip>
                            <AuthorizeView Policy="DomainsEdit" Context="senderAuthState">
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="@($"Review {identity.Label}")">
                                    <MudMenuItem OnClick="@(() => ReviewSenderAsync(identity, SenderApprovalStatus.Approved))">Approve @(identity.IsService ? $"all {identity.Label}" : "this IP")</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => ReviewSenderAsync(identity, SenderApprovalStatus.NotOurs))">Not ours</MudMenuItem>
                                    @if (status is not null)
                                    {
                                        <MudMenuItem OnClick="@(() => ReviewSenderAsync(identity, null))">Clear</MudMenuItem>
                                    }
                                </MudMenu>
                            </AuthorizeView>
                        </div>
                    </MudTd>
                    <MudTd>@context.Volume</MudTd>
                    <MudTd>
                        @if (context.DailyVolumes.Length > 0)
                        {
                            var max = Math.Max(1, context.DailyVolumes.Max());
                            <MudTooltip Text="@string.Join(" → ", context.DailyVolumes)" Arrow="true">
                                <div class="d-flex align-end" style="gap:2px; height:24px;">
                                    @foreach (var day in context.DailyVolumes)
                                    {
                                        <div style="@($"width:4px; background:var(--mud-palette-primary); height:{Math.Max(2, day * 24 / max)}px;")"></div>
                                    }
                                </div>
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.IsNewSource)
                        {
                            <MudTooltip Text="@($"First seen {(context.FirstSeenUtc is { } seen ? DotMarc.Reporting.UkTime.Date(seen) : "")}")" Arrow="true">
                                <MudChip T="string" Color="Color.Info" Size="Size.Small">New</MudChip>
                            </MudTooltip>
                        }
                        else
                        {
                            @(context.FirstSeenUtc is { } firstSeen ? DotMarc.Reporting.UkTime.Date(firstSeen) : "—")
                        }
                    </MudTd>
                    <MudTd>
                        <MudTooltip Text="@context.AuthDetailTooltip(DmarcAuthMechanism.Spf)" Arrow="true">
                            <span>@context.SpfResult</span>
                        </MudTooltip>
                    </MudTd>
                    <MudTd>
                        <MudTooltip Text="@context.AuthDetailTooltip(DmarcAuthMechanism.Dkim)" Arrow="true">
                            <span>@context.DkimResult</span>
                        </MudTooltip>
                    </MudTd>
                    <MudTd>
                        <div>@context.Disposition</div>
                        @if (!string.IsNullOrEmpty(context.ReasonSummary))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.ReasonSummary</MudText>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Raw reports">
            <MudTable Items="_reports" Hover="true" T="Report" CustomHeader="true" Filter="ReportMatchesFilters">
                <ToolBarContent>
                    <MudSpacer />
                    <MudButton Variant="@(_showReportFilters ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList"
                               OnClick="@(() => _showReportFilters = !_showReportFilters)">@(_showReportFilters ? "Hide filters" : "Filters")</MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <tr>
                        <MudTh><MudTableSortLabel SortBy="new Func<Report, object>(r => r.ReportingOrg)"><Hint Text="The organisation that sent the report, such as Google or Microsoft.">From</Hint></MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<Report, object>(r => r.DateRangeBeginUtc)"><Hint Text="The period the report covers, usually one day.">Date range</Hint></MudTableSortLabel></MudTh>
                    </tr>
                    @if (_showReportFilters)
                    {
                    <tr>
                        <MudTh><MudTextField T="string" @bind-Value="_reportFromFilter" Placeholder="Search" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" /></MudTh>
                        <MudTh><MudTextField T="string" @bind-Value="_reportDateRangeFilter" Placeholder="Search" Immediate="true" Margin="Margin.Dense" /></MudTh>
                    </tr>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ReportingOrg</MudTd>
                    <MudTd>@FormatDateRange(context.DateRangeBeginUtc, context.DateRangeEndUtc)</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
}

@code {
    private static readonly SemaphoreSlim EnrichmentThrottle = new(4);
    private static readonly string[] TabSlugs = ["overview", "mta-sts", "tls-reports", "sources", "raw-reports"];

    [Parameter] public string DomainName { get; set; } = "";
    [Parameter] public string? Tab { get; set; }

    private int _activeTabIndex;
    private Domain? _domain;
    private List<DetectedMailService> _detectedMailServices = [];
    private List<ReturnPathRow> _returnPaths = [];
    private DotMarc.Scoring.DomainScore? _score;

    private sealed record ReturnPathRow(ReturnPathDomain Domain, string? Cname);
    private List<Report> _reports = [];
    private List<TlsrptReport> _tlsrptReports = [];
    private List<SourceRow> _sources = [];

    private string? _sourceIpFilter;
    private int? _sourceMinVolumeFilter;
    private bool? _sourceIsNewFilter;
    private string? _sourceSpfFilter;
    private string? _sourceDkimFilter;
    private string? _sourceDispositionFilter;
    private string? _sourceReasonFilter;
    private string? _sourceApprovalFilter;
    private const string UnreviewedFilter = "Unreviewed";
    private Dictionary<string, SenderApproval> _senderApprovals = [];
    private bool _showSourceFilters;

    private string? _tlsrptFromFilter;
    private string? _tlsrptDateRangeFilter;
    private string? _tlsrptPolicyFilter;
    private bool? _tlsrptHasFailuresFilter;
    private string? _tlsrptFailureDetailFilter;
    private bool _showTlsrptFilters;

    private string? _reportFromFilter;
    private string? _reportDateRangeFilter;
    private bool _showReportFilters;

    private double? _passRate;
    private int _totalVolume;
    private int _sourceCount;
    private List<ChartSeries<double>> _series = [];
    private string[] _xAxisLabels = [];
    private LineChartOptions _chartOptions = new();
    private ReasonBreakdown? _reasonBreakdown;
    private double[] _reasonData = [];
    private string[] _reasonLabels = ["Benign override", "Local policy", "Other", "SPF failure (inferred)", "DKIM failure (inferred)", "SPF & DKIM failure (inferred)", "No reason given"];
    private bool _isPushingDmarcRecord;

    // Whether this person may push records for this domain from dotMARC: they need the DnsPush permission, and none of
    // the domain's Groups may be marked as managing its own DNS. Otherwise the push buttons show the records to copy.
    private bool _mayPush;

    // Whether a push can actually reach the DNS a record lives in: this person may push, and that zone's provider is one
    // dotMARC pushes to and is connected. Records in the domain's own zone use the first; the DMARC authorization record
    // lives in the reports mailbox's domain, so it uses the second (worked out in the background, as it needs DNS lookups).
    // Where a push can't reach, the row shows the record to add by hand.
    private bool _canPushDomainZone;
    private bool _canPushMailboxZone;
    private EnforcementAssessment? _enforcement;
    private bool _clientManagesDns;
    private string _noPushReason = "";
    private bool _isPushingDmarcAuthRecord;
    private bool _isRecheckingDmarc;
    private bool _isRecheckingTlsrpt;
    private bool _isRecheckingDmarcAuth;
    private bool _isRecheckingSpf;
    private bool _isRecheckingMx;
    private bool _isRecheckingDanglingCname;
    private bool _isRecheckingCertificate;
    private bool _isRecheckingDomainExpiry;
    private bool _isRecheckingLookalikes;
    private bool _isRecheckingBlocklist;
    private bool _showLookalikes;
    private List<LookalikeDomain> _lookalikes = [];
    private bool _isRecheckingDkim;
    private bool _isRecheckingDnsProvider;
    private DotNetObjectReference<DomainDetail>? _dotNetRef;

    public void Dispose() => _dotNetRef?.Dispose();

    private static bool ContainsIgnoreCase(string? text, string? search) =>
        string.IsNullOrWhiteSpace(search) || (text ?? "").Contains(search, StringComparison.OrdinalIgnoreCase);

    private static string FormatDateRange(DateTimeOffset beginUtc, DateTimeOffset endUtc) => $"{DotMarc.Reporting.UkTime.Date(beginUtc)} – {DotMarc.Reporting.UkTime.Date(endUtc)}";

    private static string TlsrptPolicySummary(TlsrptReport report) =>
        string.Join(", ", report.Policies.Select(policy => $"{policy.PolicyType}: {policy.PolicyDomain}"));

    private static string TlsrptFailureSummary(TlsrptReport report) =>
        string.Join(", ", report.Policies.SelectMany(policy => policy.FailureDetails).Select(detail => $"{detail.ResultType} ({detail.FailedSessionCount})"));

    /// <summary>Who the source's address is registered to and where, for the line under its name; null when neither is
    /// known, or when the service line above already names the owner and there's no country to add.</summary>
    private static string? OwnerLine(SourceRow source)
    {
        var owner = source.Identity.IsService && source.HostName is null ? null : source.Organization;
        var parts = new[] { owner, source.Country }.Where(part => !string.IsNullOrWhiteSpace(part)).ToList();
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    private bool SourceMatchesFilters(SourceRow source)
    {
        var searched = string.IsNullOrWhiteSpace(_sourceIpFilter)
            || new[] { source.SourceIp, source.HostName, source.Identity.Label, source.Organization, source.Country }.Any(value => ContainsIgnoreCase(value ?? "", _sourceIpFilter));
        if (!searched || !ContainsIgnoreCase(source.ReasonSummary, _sourceReasonFilter))
        {
            return false;
        }
        if (_sourceApprovalFilter is not null && ApprovalLabel(source) != _sourceApprovalFilter)
        {
            return false;
        }
        if (_sourceMinVolumeFilter is { } minVolume && source.Volume < minVolume)
        {
            return false;
        }
        if (_sourceIsNewFilter is { } isNew && source.IsNewSource != isNew)
        {
            return false;
        }
        if (_sourceSpfFilter is not null && source.SpfResult != _sourceSpfFilter)
        {
            return false;
        }
        if (_sourceDkimFilter is not null && source.DkimResult != _sourceDkimFilter)
        {
            return false;
        }
        if (_sourceDispositionFilter is not null && source.Disposition != _sourceDispositionFilter)
        {
            return false;
        }
        return true;
    }

    private bool TlsrptReportMatchesFilters(TlsrptReport report)
    {
        if (!ContainsIgnoreCase(report.ReportingOrg, _tlsrptFromFilter)
            || !ContainsIgnoreCase(FormatDateRange(report.DateRangeBeginUtc, report.DateRangeEndUtc), _tlsrptDateRangeFilter)
            || !ContainsIgnoreCase(TlsrptPolicySummary(report), _tlsrptPolicyFilter)
            || !ContainsIgnoreCase(TlsrptFailureSummary(report), _tlsrptFailureDetailFilter))
        {
            return false;
        }
        if (_tlsrptHasFailuresFilter is { } hasFailures && report.Policies.Any(policy => policy.FailedSessionCount > 0) != hasFailures)
        {
            return false;
        }
        return true;
    }

    private bool ReportMatchesFilters(Report report) =>
        ContainsIgnoreCase(report.ReportingOrg, _reportFromFilter)
        && ContainsIgnoreCase(FormatDateRange(report.DateRangeBeginUtc, report.DateRangeEndUtc), _reportDateRangeFilter);

    protected override void OnParametersSet()
    {
        var index = Tab is null ? -1 : Array.IndexOf(TabSlugs, Tab.ToLowerInvariant());
        _activeTabIndex = index >= 0 ? index : 0;
    }

    private Task OnActiveTabIndexChangedAsync(int index)
    {
        _activeTabIndex = index;
        var slug = TabSlugs[index >= 0 && index < TabSlugs.Length ? index : 0];
        Navigation.NavigateTo($"/domains/{DomainName}/{slug}", replace: true);
        return Task.CompletedTask;
    }

    private Task NavigateToTabAsync(string slug)
    {
        var index = Array.IndexOf(TabSlugs, slug);
        return OnActiveTabIndexChangedAsync(index >= 0 ? index : 0);
    }

    protected override async Task OnInitializedAsync()
    {
        // See Dashboard.razor's OnInitializedAsync for why this is a fresh, untracked,
        // factory-created context rather than an injected DotMarcDbContext.
        await using var db = await DbFactory.CreateDbContextAsync();

        var cutoff = DomainStatistics.GetWindowCutoffUtc();
        _domain = await db.Domains
            .AsNoTracking()
            .Include(d => d.Reports.Where(r => r.ReceivedUtc >= cutoff))
            .ThenInclude(r => r.Records)
            .Include(d => d.Reports.Where(r => r.ReceivedUtc >= cutoff))
            .ThenInclude(r => r.Records)
            .ThenInclude(rec => rec.AuthDetails)
            .Include(d => d.Reports.Where(r => r.ReceivedUtc >= cutoff))
            .ThenInclude(r => r.Records)
            .ThenInclude(rec => rec.OverrideReasons)
            .Include(d => d.TlsrptReports.Where(r => r.ReceivedUtc >= cutoff))
            .ThenInclude(r => r.Policies)
            .ThenInclude(policy => policy.FailureDetails)
            .Include(d => d.Groups)
            .Include(d => d.DkimRecords)
            // Several sibling collections (auth details, override reasons, TLSRPT policies, groups)
            // in one result would multiply rows and repeat every report's RawXml on each of them.
            .AsSplitQuery()
            .SingleOrDefaultAsync(d => d.Name == DomainName);

        if (_domain is null)
        {
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var scopedGroupClaims = authState.User.FindAll(DotMarc.Security.UserAccessClaimsTransformation.ScopedGroupClaimType).ToList();
        if (scopedGroupClaims.Count > 0)
        {
            var scopedGroupIds = scopedGroupClaims.Select(c => int.Parse(c.Value)).ToHashSet();
            var domainGroupIds = _domain.Groups.Select(g => g.Id).ToHashSet();
            if (!domainGroupIds.Overlaps(scopedGroupIds))
            {
                Navigation.NavigateTo("/AccessDenied");
                return;
            }
        }

        _senderApprovals = await SenderApprovalService.GetAsync(db, _domain.Id);
        _lookalikes = await LoadLookalikesAsync(db, _domain.Id);
        _clientManagesDns = _domain.Groups.Any(group => group.ClientManagesDns);
        _mayPush = !_clientManagesDns && (await AuthorizationService.AuthorizeAsync(authState.User, nameof(Permission.DnsPush))).Succeeded;
        await RefreshDomainZonePushAsync();
        _noPushReason = _clientManagesDns
            ? $"{string.Join(", ", _domain.Groups.Where(group => group.ClientManagesDns).Select(group => group.Name))} manages its own DNS, so dotMARC doesn't push records for this domain."
            : "You don't have permission to push records to DNS from dotMARC.";
        _enforcement = (await EnforcementData.AssessAsync(db, [_domain], DateTimeOffset.UtcNow))[_domain.Id];
        _score = DotMarc.Scoring.SecurityScoreData.For(_domain, _domain.Reports);
        _reports = _domain.Reports.OrderByDescending(r => r.ReceivedUtc).ToList();
        _tlsrptReports = _domain.TlsrptReports.OrderByDescending(report => report.ReceivedUtc).ToList();

        _totalVolume = DomainStatistics.GetTotalVolume(_domain.Reports);
        _sourceCount = _domain.Reports.SelectMany(r => r.Records).Select(r => r.SourceIp).Distinct().Count();
        _passRate = DomainStatistics.GetPassRate(_domain.Reports);

        _sources = DomainStatistics.GetSourceAggregates(_domain.Reports)
            .Select(a => new SourceRow(a.SourceIp, a.Volume, a.SpfResult.ToString(), a.DkimResult.ToString(), a.Disposition.ToString(), a.OverrideReasonTypes, a.AuthDetails, a.InferredReason))
            .OrderByDescending(s => s.Volume)
            .ToList();
        var recordsByIp = _domain.Reports.SelectMany(report => report.Records).ToLookup(record => record.SourceIp);
        foreach (var source in _sources)
        {
            source.DetectedForwarding = ForwardingDetector.Detect(source.Volume, recordsByIp[source.SourceIp].Select(ForwardingEvidence.From));
        }

        _returnPaths = ReturnPathDomains.From(_domain.Name, _domain.Reports).Take(5).Select(domain => new ReturnPathRow(domain, null)).ToList();
        _ = LoadReturnPathCnamesAsync(_returnPaths);

        // First-seen is across the source's ENTIRE history for this domain, not just the 30-day
        // window everything else here uses - a source that's been sending for a year reads very
        // differently from one that showed up for the first time this week, and the windowed
        // Reports already Include()d above can't tell the two apart. Projected straight to a
        // (SourceIp, MIN(ReceivedUtc)) pair rather than loading full report/record graphs, since
        // that's all this needs.
        var firstSeenBySource = await db.ReportRecords
            .Where(rr => rr.Report.DomainId == _domain.Id)
            .GroupBy(rr => rr.SourceIp)
            .Select(g => new { SourceIp = g.Key, FirstSeenUtc = g.Min(rr => rr.Report.ReceivedUtc) })
            .ToDictionaryAsync(x => x.SourceIp, x => x.FirstSeenUtc);

        var dailyVolumesBySource = DomainStatistics.GetSourceDailyVolumes(_domain.Reports, trendDays: 7);
        foreach (var source in _sources)
        {
            if (firstSeenBySource.TryGetValue(source.SourceIp, out var firstSeenUtc))
            {
                source.FirstSeenUtc = firstSeenUtc;
            }
            if (dailyVolumesBySource.TryGetValue(source.SourceIp, out var dailyVolumes))
            {
                source.DailyVolumes = dailyVolumes;
            }
        }

        // Blazor Server's default prerendering means OnInitializedAsync genuinely runs twice on
        // every cold page load: once for the static prerender pass (no live circuit, no
        // SignalR connection back to the browser yet), once again when the real interactive
        // circuit starts. That's harmless for the plain DB queries above, but the enrichment
        // kick-off below makes real network calls (RDAP lookups) through a process-wide
        // semaphore - running it during the prerender pass would double every lookup and burn a
        // throttle permit that pass can't even display the result of (its renderer is disposed
        // by the time InvokeAsync(StateHasChanged) below would run). RendererInfo.IsInteractive
        // is false during prerendering and true once the interactive circuit is live, so gating
        // on it here confines enrichment to the one execution that can actually show it.
        if (RendererInfo.IsInteractive)
        {
            var ips = _sources.Select(s => s.SourceIp).Distinct().ToList();
            var cachedInfo = await IpInfoService.GetCachedAsync(db, ips, CancellationToken.None);
            var cachedRanges = await IpInfoService.GetCachedRangesAsync(db, CancellationToken.None);
            var cachedHostNames = await IpHostNameService.GetCachedAsync(db, ips, CancellationToken.None);
            var nowUtc = DateTimeOffset.UtcNow;

            foreach (var source in _sources)
            {
                cachedHostNames.TryGetValue(source.SourceIp, out var cachedHostName);
                source.HostName = cachedHostName?.HostName;
                if (IpHostNameService.NeedsLookup(cachedHostName, nowUtc))
                {
                    source.IsHostNamePending = true;
                    _ = LookUpHostNameInBackgroundAsync(source);
                }
            }

            foreach (var source in _sources)
            {
                cachedInfo.TryGetValue(source.SourceIp, out var info);
                if (info is not null && !IpInfoService.NeedsLookup(info, nowUtc))
                {
                    source.Organization = info.Organization;
                    source.Country = info.Country;
                    source.IsEnrichmentPending = false;
                }
                else if (IpRangeMatcher.FindContaining(cachedRanges, source.SourceIp) is { } range)
                {
                    // A different IP in the same RDAP allocation block was already looked up - 
                    // no need to spend another background lookup (or throttle permit) on this
                    // one, or to write it its own IpInfo row; the range cache alone covers it.
                    source.Organization = range.Organization;
                    source.Country = range.Country;
                    source.IsEnrichmentPending = false;
                }
                else
                {
                    _ = EnrichSourceInBackgroundAsync(source);
                }
            }

            _ = DetectMailServicesInBackgroundAsync();
            _ = DetectMailboxZonePushInBackgroundAsync();
        }

        // Bucket by day-received (of the report, not the record) rather than the record itself,
        // since ReportRecord has no timestamp of its own - Report.ReceivedUtc is what's available.
        var dailyBuckets = _domain.Reports
            .SelectMany(r => r.Records.Select(rec => new { Date = DateOnly.FromDateTime(r.ReceivedUtc.UtcDateTime), rec.Disposition, rec.MessageCount }))
            .GroupBy(x => x.Date)
            .ToDictionary(g => g.Key, g => new
            {
                None = g.Where(x => x.Disposition == DispositionResult.None).Sum(x => x.MessageCount),
                Quarantine = g.Where(x => x.Disposition == DispositionResult.Quarantine).Sum(x => x.MessageCount),
                Reject = g.Where(x => x.Disposition == DispositionResult.Reject).Sum(x => x.MessageCount)
            });

        // The 30 days up to yesterday: today's reports mostly arrive tomorrow, so a point for today would always dip,
        // looking as if mail had stopped.
        var days = Enumerable.Range(0, 30)
            .Select(i => DateOnly.FromDateTime(DateTime.UtcNow.AddDays(-30 + i)))
            .ToList();
        // A date every five days (and today), so 30 labels don't run into each other.
        _xAxisLabels = days.Select((d, i) => i % 5 == 0 || i == days.Count - 1 ? d.ToString("d MMM") : "").ToArray();
        _series =
        [
            new ChartSeries<double> { Name = "Delivered", Data = days.Select(d => (double)(dailyBuckets.TryGetValue(d, out var b) ? b.None : 0)).ToArray() },
            new ChartSeries<double> { Name = "Quarantined", Data = days.Select(d => (double)(dailyBuckets.TryGetValue(d, out var b) ? b.Quarantine : 0)).ToArray() },
            new ChartSeries<double> { Name = "Rejected", Data = days.Select(d => (double)(dailyBuckets.TryGetValue(d, out var b) ? b.Reject : 0)).ToArray() }
        ];

        // A y-axis scale that fits the busiest day in four or five steps, instead of one fixed step that can leave
        // nothing but 0 on the axis.
        var busiest = _series.SelectMany(series => series.Data.Values).DefaultIfEmpty(0).Max();
        _chartOptions = new LineChartOptions { YAxisTicks = NiceStep(busiest / 4), YAxisFormat = "N0", YAxisLines = true };

        _reasonBreakdown = DomainStatistics.GetReasonBreakdown(_domain.Reports);
        _reasonData = [_reasonBreakdown.BenignOverride, _reasonBreakdown.LocalPolicy, _reasonBreakdown.Other, _reasonBreakdown.InferredSpfFailure, _reasonBreakdown.InferredDkimFailure, _reasonBreakdown.InferredBothFailure, _reasonBreakdown.NoReasonGiven];
    }

    /// <summary>1, 2 or 5 times a power of ten, at least 1: a round step for the chart's y-axis.</summary>
    private static int NiceStep(double rough)
    {
        if (rough <= 1)
        {
            return 1;
        }

        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(rough)));
        var step = new[] { 1, 2, 5, 10 }.Select(multiple => multiple * magnitude).First(candidate => candidate >= rough);
        return (int)Math.Min(step, int.MaxValue);
    }

    /// <summary>Shows the records a push would change, to copy into the DNS provider by hand.</summary>
    private async Task ShowRecordsAsync(string target, string title, string? payload = null)
    {
        var builder = ChangeBuilders.Find(target);
        if (builder is null || _domain is null)
        {
            return;
        }

        DnsChangePlan plan;
        try
        {
            plan = await builder.BuildAsync(new DnsPushRequest(_domain, "", _domain.DnsZone ?? _domain.Name, payload), CancellationToken.None);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Snackbar.Add("Couldn't look up the current DNS records. Try again.", Severity.Error);
            return;
        }

        if (plan.Refusal is not null || plan.Changes.Count == 0)
        {
            Snackbar.Add(plan.Refusal is null ? "DNS already has the right records." : "dotMARC can't work out the records for this domain yet.", Severity.Info);
            return;
        }

        await DialogService.ShowAsync<RecordsToAddDialog>(title, new DialogParameters<RecordsToAddDialog>
        {
            { x => x.Title, title },
            { x => x.ZoneHint, plan.Changes[0].ZoneName },
            { x => x.Changes, plan.Changes },
        }, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }

    private SenderApprovalStatus? ApprovalStatus(SourceRow source) =>
        _senderApprovals.TryGetValue(source.Identity.Key, out var approval) ? approval.Status : null;

    private string ApprovalLabel(SourceRow source) =>
        ApprovalStatus(source) is null && source.Identity.IsForwarder ? "Forwarder" : SenderApprovalService.Describe(ApprovalStatus(source));

    private string ApprovalTooltip(SenderIdentity identity)
    {
        var scope = identity.IsService ? $"Covers every {identity.Label} server sending this domain's mail." : "Covers this IP only.";
        return _senderApprovals.TryGetValue(identity.Key, out var approval)
            ? $"{SenderApprovalService.Describe(approval.Status)} by {approval.DecidedBy} on {DotMarc.Reporting.UkTime.Date(approval.DecidedUtc)}. {scope}"
            : identity.ForwardingReason is { } detected
                ? $"Detected as forwarding. {detected} It isn't a sender of the domain's own, so there's nothing to review; mark it not ours if you disagree. {scope}"
            : identity.IsForwarder
                ? $"A mail forwarder: someone this domain emailed has their address pass mail on through {identity.Label}. It isn't the domain's own sender, so there's nothing to review. {scope}"
                : $"Nobody has reviewed this sender yet. {scope}";
    }

    /// <summary>Approves a sender, marks it not ours, or clears that (null). The menu only shows for DomainsEdit, but a
    /// Blazor event can be raised without it, so the permission is checked again here.</summary>
    private async Task ReviewSenderAsync(SenderIdentity identity, SenderApprovalStatus? status)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthorizationService.AuthorizeAsync(authState.User, "DomainsEdit")).Succeeded)
        {
            Snackbar.Add("You don't have permission to review senders.", Severity.Warning);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await SenderApprovalService.SetAsync(db, await AuditActorAccessor.GetAsync(), _domain!.Id, identity.Key, status);
        _senderApprovals = await SenderApprovalService.GetAsync(db, _domain.Id);
    }

    private async Task EnrichSourceInBackgroundAsync(SourceRow source)
    {
        await EnrichmentThrottle.WaitAsync().ConfigureAwait(false);
        try
        {
            var info = await IpInfoService.EnrichAsync(DbFactory, IpLookup, source.SourceIp, CancellationToken.None).ConfigureAwait(false);
            source.Organization = info.Organization;
            source.Country = info.Country;

            if (info.Status != IpLookupStatus.Ok)
            {
                // Operational visibility for the failure mode this feature already hit once
                // (rdap.org's WAF silently rejecting requests): the orchestrating caller logs, not
                // the low-level checker (RdapIpInfoLookup) itself - matches
                // PollingService.RunDmarcCheckCycleAsync's logging around DmarcDnsChecker.
                Logger.LogWarning("RDAP lookup for source IP {SourceIp} did not resolve to Ok (status: {Status}).", source.SourceIp, info.Status);
            }
        }
        catch (Exception ex)
        {
            // Leave Organization/Country null - the row settles into an "unknown" state below
            // rather than spinning forever. EnrichAsync itself already turns network failures
            // into a persisted LookupFailed IpInfo row; this catch only guards against something
            // unexpected in that path taking down the whole fire-and-forget task.
            Logger.LogWarning(ex, "Background RDAP enrichment for source IP {SourceIp} threw unexpectedly.", source.SourceIp);
        }
        finally
        {
            EnrichmentThrottle.Release();
            source.IsEnrichmentPending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Reverse DNS for one source, off the render path and through the same throttle as the owner lookups.
    /// A source with no name, or one the lookup couldn't find, just keeps showing its IP.</summary>
    private async Task LookUpHostNameInBackgroundAsync(SourceRow source)
    {
        await EnrichmentThrottle.WaitAsync().ConfigureAwait(false);
        try
        {
            var cached = await IpHostNameService.EnrichAsync(DbFactory, ReverseDnsLookup, source.SourceIp, CancellationToken.None).ConfigureAwait(false);
            source.HostName = cached.HostName;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Reverse DNS lookup for source IP {SourceIp} failed.", source.SourceIp);
        }
        finally
        {
            EnrichmentThrottle.Release();
            source.IsHostNamePending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>The reports mailbox's domain: where every monitored domain's DMARC authorization record lives.</summary>
    private string MailboxDomain => GraphOptions.Value.MailboxAddress[(GraphOptions.Value.MailboxAddress.IndexOf('@') + 1)..];

    private async Task RefreshDomainZonePushAsync() =>
        _canPushDomainZone = _mayPush && await DnsPushProviders.FindConfiguredAsync(_domain!.DnsProvider.ToProviderKey()) is not null;

    private async Task DetectMailboxZonePushInBackgroundAsync()
    {
        if (!_mayPush)
        {
            return;
        }

        try
        {
            var mailbox = GraphOptions.Value.MailboxAddress;
            var detected = await DnsProviderDetector.DetectAsync(mailbox[(mailbox.IndexOf('@') + 1)..], CancellationToken.None).ConfigureAwait(false);
            _canPushMailboxZone = await DnsPushProviders.FindConfiguredAsync(detected.Provider.ToProviderKey()).ConfigureAwait(false) is not null;
        }
        catch (Exception ex)
        {
            // Leaves Show record in place of the push button; nothing else on the page depends on it.
            Logger.LogWarning(ex, "Failed to detect the DNS provider of the reports mailbox's domain.");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Runs mail service detection (MX + SPF DNS-over-HTTPS lookups) off the render
    /// path, mirroring EnrichSourceInBackgroundAsync above - awaiting this directly in
    /// OnInitializedAsync would block the whole page load on two sequential DNS-over-HTTPS round
    /// trips, worst case stalling on the typed HttpClient's default 100-second timeout.</summary>
    private async Task DetectMailServicesInBackgroundAsync()
    {
        try
        {
            _detectedMailServices = await MailServiceDetector.DetectAsync(DomainName, CancellationToken.None).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            // Informational-only badges - a transient DNS failure here shouldn't disrupt the
            // rest of the page load. Logged so a persistent failure is still diagnosable.
            Logger.LogWarning(ex, "Failed to detect mail services for {DomainName}.", DomainName);
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Enforcement readiness's next step: pushes the DMARC record with the stricter policy, after showing the
    /// change.</summary>
    /// <summary>Fills in where each return-path subdomain points, once the page is up: a slow lookup only delays this.</summary>
    private async Task LoadReturnPathCnamesAsync(List<ReturnPathRow> rows)
    {
        try
        {
            var targets = await Task.WhenAll(rows.Select(row => CnameLookup.LookupAsync(row.Domain.Name, CancellationToken.None)));
            if (!ReferenceEquals(rows, _returnPaths))
            {
                return;
            }
            _returnPaths = rows.Select((row, index) => row with { Cname = targets[index] }).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Couldn't look up return-path CNAMEs for {Domain}", _domain?.Name);
        }
    }

    /// <summary>The service behind a return-path subdomain: from where its CNAME points, else from the servers using it.</summary>
    private string? ReturnPathSender(ReturnPathRow row) =>
        (row.Cname is { } cname ? DotMarc.Senders.KnownSenders.Recognise(cname, null)?.Name : null)
        ?? _sources.Where(source => row.Domain.SourceIps.Contains(source.SourceIp) && source.Identity.IsService)
            .OrderByDescending(source => source.Volume).Select(source => source.Identity.Label).FirstOrDefault();

    /// <summary>The services to suggest for SPF from the reports: recognised services approved as this domain's mail, and
    /// those behind a return-path subdomain (its CNAME was set up for them). Not every service seen: forwarders and
    /// spoofers show up in reports too.</summary>
    private IEnumerable<string> ReportedServices() =>
        _sources.Where(source => source.Identity.IsService && ApprovalStatus(source) == SenderApprovalStatus.Approved).Select(source => source.Identity.Label)
            .Concat(_returnPaths.Select(ReturnPathSender).OfType<string>())
            .Distinct();

    /// <summary>One line for the enforcement row; the full reasons are in its tooltip.</summary>
    private static string EnforcementSummary(EnforcementAssessment enforcement)
    {
        if (enforcement.Enforced)
        {
            return "Fully enforced: mail failing DMARC is rejected.";
        }
        var next = enforcement.NextPolicy is { } policy ? $"p={policy.ToString().ToLowerInvariant()}" : null;
        if (enforcement.Ready)
        {
            return $"Ready for {next}.";
        }
        var reasons = string.Join("; ", enforcement.Blockers.Select(blocker => blocker.Title == "Not enough reports yet" && enforcement.Volume > 0
            ? $"{enforcement.DaysOfData} of the {EnforcementReadiness.DaysNeeded} days of reports needed"
            : blocker.Title.ToLowerInvariant()));
        var stuck = enforcement.StuckMonitoring ? " On p=none for over 30 days." : "";
        return next is null ? $"{enforcement.Blockers.FirstOrDefault()?.Detail}" : $"Not ready for {next}: {reasons}.{stuck}";
    }

    private async Task PushPolicyAsync(DmarcPolicyLevel policy)
    {
        var providerKey = _domain!.DnsProvider.ToProviderKey();
        var pushProvider = await DnsPushProviders.FindConfiguredAsync(providerKey);
        if (pushProvider is null)
        {
            Snackbar.Add(_domain!.DnsProvider.NoPushReason(DomainName), Severity.Warning);
            return;
        }

        var name = policy == DmarcPolicyLevel.Reject ? "reject" : "quarantine";
        var builder = ChangeBuilders.Find("dmarc-policy")!;
        DnsChangePlan plan;
        try
        {
            plan = await builder.BuildAsync(new DnsPushRequest(_domain, pushProvider.ProviderKey, _domain.DnsZone ?? _domain.Name, name), CancellationToken.None);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Snackbar.Add("Couldn't look up the current DMARC record. Try again.", Severity.Error);
            return;
        }

        if (plan.Refusal is not null || plan.Changes.Count == 0)
        {
            Snackbar.Add(plan.Refusal is null ? $"The DMARC record is already at p={name}." : "This DMARC record can't be changed from here: it's missing, or delegated elsewhere.", Severity.Warning);
            return;
        }

        var change = plan.Changes[0];
        var confirmed = await DialogService.ShowMessageBoxAsync($"Move {DomainName} to p={name}",
            (MarkupString)$"<p>Now: <code>{System.Net.WebUtility.HtmlEncode(change.ExistingValue)}</code></p><p>New: <code>{System.Net.WebUtility.HtmlEncode(change.DesiredValue)}</code></p>" +
            (policy == DmarcPolicyLevel.Reject ? "<p>Mail that fails DMARC will be refused. Undo it by pushing p=quarantine again if something goes wrong.</p>" : "<p>Mail that fails DMARC will go to junk.</p>"),
            yesText: "Push", cancelText: "Cancel");
        if (confirmed == true)
        {
            await OpenDnsPushPopupAsync(pushProvider.ProviderKey, _domain.Id, "dmarc-policy", name);
        }
    }

    private async Task PushDmarcRecordAsync()
    {
        _isPushingDmarcRecord = true;
        try
        {
            var providerKey = _domain!.DnsProvider.ToProviderKey();
            var pushProvider = await DnsPushProviders.FindConfiguredAsync(providerKey);
            if (pushProvider is null)
            {
                Snackbar.Add(_domain!.DnsProvider.NoPushReason(DomainName), Severity.Warning);
                return;
            }

            DnsRecordLookupResult existing;
            try
            {
                existing = await DmarcTxtLookup.LookupAsync(DomainName, CancellationToken.None);
            }
            catch (Exception)
            {
                Snackbar.Add($"Failed to look up {DomainName}'s current DMARC record. Try again.", Severity.Error);
                return;
            }

            // A CNAME-delegated record (existing.DelegatedToCname set) always gets a fresh
            // create-style value, matching what the server actually pushes for this case - merging
            // the third party's own policy content in wouldn't make sense once their delegation is
            // being replaced entirely.
            string proposed;
            if (existing.DelegatedToCname is not null || existing.DirectValue is null)
            {
                proposed = $"v=DMARC1; p=none; rua=mailto:{GraphOptions.Value.MailboxAddress}";
            }
            else
            {
                var merged = DmarcRuaMerge.TryMerge(existing.DirectValue, GraphOptions.Value.MailboxAddress);
                if (merged is null)
                {
                    Snackbar.Add("Couldn't safely compute a fix for this record - it needs a manual look.", Severity.Warning);
                    return;
                }
                proposed = merged;
            }

            if (DnsRecordPushDecision.NeedsConfirmation(existing.DirectValue, existing.DelegatedToCname, proposed))
            {
                var parameters = new DialogParameters<ConfirmDnsRecordPushDialog>
                {
                    { x => x.RecordDescription, "DMARC record" },
                    { x => x.RecordName, $"_dmarc.{DomainName}" },
                    { x => x.ExistingValue, existing.DirectValue ?? "" },
                    { x => x.ProposedValue, proposed },
                    { x => x.DelegatedToCname, existing.DelegatedToCname }
                };
                var dialogRef = await DialogService.ShowAsync<ConfirmDnsRecordPushDialog>("Push DMARC record", parameters);
                var result = await dialogRef.Result;
                if (result is null || result.Canceled)
                {
                    return;
                }
            }

            await OpenDnsPushPopupAsync(pushProvider.ProviderKey, _domain!.Id, "dmarc");
        }
        finally
        {
            _isPushingDmarcRecord = false;
        }
    }

    /// <summary>Pushes the RFC 7489 §7.1 authorization record proving the mailbox's own domain
    /// accepts DMARC reports for this monitored domain. Unlike PushDmarcRecordAsync/
    /// PushTlsrptRecordAsync, the record being pushed doesn't live in THIS domain's zone - it
    /// lives in the mailbox's domain's zone (typically the MSP's own domain), so provider
    /// detection and the push itself both target that domain instead of DomainName. See
    /// Program.cs's "dmarc-auth" callback branch for the matching server-side half.</summary>
    private async Task PushDmarcAuthorizationRecordAsync()
    {
        _isPushingDmarcAuthRecord = true;
        try
        {
            var mailbox = GraphOptions.Value.MailboxAddress;
            var mailboxDomain = mailbox[(mailbox.IndexOf('@') + 1)..];

            var detected = await DnsProviderDetector.DetectAsync(mailboxDomain, CancellationToken.None);
            var providerKey = detected.Provider.ToProviderKey();
            var pushProvider = await DnsPushProviders.FindConfiguredAsync(providerKey);
            if (pushProvider is null)
            {
                Snackbar.Add(detected.Provider.NoPushReason(mailboxDomain), Severity.Warning);
                return;
            }

            var authorizationName = $"{DomainName}._report._dmarc.{mailboxDomain}";
            DnsRecordLookupResult existing;
            try
            {
                existing = await DmarcAuthorizationTxtLookup.LookupAsync(authorizationName, CancellationToken.None);
            }
            catch (Exception)
            {
                Snackbar.Add($"Failed to look up {DomainName}'s DMARC authorization record. Try again.", Severity.Error);
                return;
            }

            const string proposed = "v=DMARC1;";
            if (DnsRecordPushDecision.NeedsConfirmation(existing.DirectValue, existing.DelegatedToCname, proposed))
            {
                var parameters = new DialogParameters<ConfirmDnsRecordPushDialog>
                {
                    { x => x.RecordDescription, "DMARC authorization record" },
                    { x => x.RecordName, authorizationName },
                    { x => x.ExistingValue, existing.DirectValue ?? "" },
                    { x => x.ProposedValue, proposed },
                    { x => x.DelegatedToCname, existing.DelegatedToCname }
                };
                var dialogRef = await DialogService.ShowAsync<ConfirmDnsRecordPushDialog>("Push DMARC authorization record", parameters);
                var result = await dialogRef.Result;
                if (result is null || result.Canceled)
                {
                    return;
                }
            }

            await OpenDnsPushPopupAsync(pushProvider.ProviderKey, _domain!.Id, "dmarc-auth");
        }
        finally
        {
            _isPushingDmarcAuthRecord = false;
        }
    }

    private async Task PushTlsrptRecordAsync()
    {
        var providerKey = _domain!.DnsProvider.ToProviderKey();
        var pushProvider = await DnsPushProviders.FindConfiguredAsync(providerKey);
        if (pushProvider is null)
        {
            Snackbar.Add(_domain!.DnsProvider.NoPushReason(DomainName), Severity.Warning);
            return;
        }

        DnsRecordLookupResult existing;
        try
        {
            existing = await TlsrptTxtLookup.LookupAsync(DomainName, CancellationToken.None);
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to look up {DomainName}'s current TLS reporting record. Try again.", Severity.Error);
            return;
        }

        var mailbox = GraphOptions.Value.TlsReportingAddress;
        if (string.IsNullOrWhiteSpace(mailbox))
        {
            Snackbar.Add("TLS reporting isn't configured on this deployment.", Severity.Warning);
            return;
        }

        // See PushDmarcRecordAsync's equivalent comment: a CNAME-delegated record always gets a
        // fresh create-style value, matching what the server actually pushes for this case.
        string proposed;
        if (existing.DelegatedToCname is not null || existing.DirectValue is null)
        {
            proposed = $"v=TLSRPTv1; rua=mailto:{mailbox}";
        }
        else
        {
            var merged = TlsrptRuaMerge.TryMerge(existing.DirectValue, mailbox);
            if (merged is null)
            {
                Snackbar.Add("Couldn't safely compute a fix for this record - it needs a manual look.", Severity.Warning);
                return;
            }
            proposed = merged;
        }

        if (DnsRecordPushDecision.NeedsConfirmation(existing.DirectValue, existing.DelegatedToCname, proposed))
        {
            var parameters = new DialogParameters<ConfirmDnsRecordPushDialog>
            {
                { x => x.RecordDescription, "TLS reporting record" },
                { x => x.RecordName, $"_smtp._tls.{DomainName}" },
                { x => x.ExistingValue, existing.DirectValue ?? "" },
                { x => x.ProposedValue, proposed },
                { x => x.DelegatedToCname, existing.DelegatedToCname }
            };
            var dialogRef = await DialogService.ShowAsync<ConfirmDnsRecordPushDialog>("Push TLS reporting record", parameters);
            var result = await dialogRef.Result;
            if (result is null || result.Canceled)
            {
                return;
            }
        }

        await OpenDnsPushPopupAsync(pushProvider.ProviderKey, _domain!.Id, "tlsrpt");
    }

    /// <summary>Runs PollingService's own per-domain DMARC check on demand, outside its ~24h

@page "/access"
@page "/access/{Tab}"
@layout DotMarc.Components.Layout.ManageLayout
@attribute [Authorize(Policy = "AccessManage")]
@using DotMarc.Components.Shared
@using DotMarc.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AuditActorAccessor AuditActorAccessor
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject DotMarc.Graph.IEntraGuestInviter GuestInviter
@inject DotMarc.Audit.AuditRecorder AuditRecorder

<PageTitle>dotMARC - Manage Access</PageTitle>
<div class="d-flex align-center mb-1">
    <MudText Typo="Typo.h4">Manage access</MudText>
    <DocsLink Href="https://dotmarc.app/docs/permissions-and-access#roles" Text="How roles and permissions work" Class="ml-2" />
</div>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    Roles are built from fine-grained permissions and control what someone can see and do. Admin
    and Viewer come built in; custom roles can cover any subset. A role that's limited to groups,
    such as Viewer, can be granted with specific Groups, so the person sees and manages only those
    Groups' domains: for external clients, or for staff who look after particular clients. API keys
    get a role the same way, for scripts and other tools.
</MudText>

<MudPaper Class="pa-4" Elevation="1">
<MudTabs ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="OnActiveTabIndexChanged">
    <MudTabPanel Text="People" Icon="@Icons.Material.Filled.People">
        <div class="pt-4">
        <MudGrid>
            <MudItem xs="5">
                <MudTextField @bind-Value="_newGrantEmail" Label="Email" Placeholder="person@example.com" Variant="Variant.Outlined"
                              Error="@(_addGrantError is not null)" ErrorText="@_addGrantError" Immediate="true" />
            </MudItem>
            <MudItem xs="3">
                <MudSelect T="int" @bind-Value="_newGrantRoleId" Label="Role" Variant="Variant.Outlined">
                    @foreach (var role in _roles ?? [])
                    {
                        <MudSelectItem T="int" Value="role.Id">@role.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (SelectedNewGrantRoleIsScopable)
            {
                <MudItem xs="4">
                    <SearchableMultiSelect TValue="int" Options="@(_allGroups.Select(group => new SelectOption<int>(group.Id, group.Name)).ToList())"
                                           @bind-SelectedValues="_newGrantGroupIds" Label="Groups" Variant="Variant.Outlined"
                                           MultiSelectionTextFunc="@(selected => selected.Count == 0 ? "All (unrestricted)" : $"{selected.Count} group(s)")" />
                </MudItem>
            }
            <MudItem xs="12" Class="d-flex justify-end align-center" Style="gap:1rem">
                @if (GuestInviter.IsAvailable)
                {
                    <FieldWithHelp Topic="Invite to Entra as a guest" Help="@InviteAsGuestHelp">
                        <MudCheckBox T="bool" @bind-Value="_inviteAsGuest" Label="Invite to Entra as a guest" Color="Color.Primary" Dense="true" />
                    </FieldWithHelp>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="GrantAccessAsync">Grant access</MudButton>
            </MudItem>
        </MudGrid>

        @if (_grants is { Count: > 0 })
        {
            <MudTable Items="_grants" Hover="true" T="GrantRow" Class="mt-4" CustomHeader="true" Filter="GrantMatchesFilters">
                <ToolBarContent>
                    <MudSpacer />
                    <MudButton Variant="@(_showGrantFilters ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList"
                               OnClick="@(() => _showGrantFilters = !_showGrantFilters)">@(_showGrantFilters ? "Hide filters" : "Filters")</MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <tr>
                        <MudTh><MudTableSortLabel SortBy="new Func<GrantRow, object>(g => g.Email)">Email</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GrantRow, object>(g => g.IsBound)">Status</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GrantRow, object>(g => g.RoleName)">Role</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GrantRow, object>(g => g.ScopedGroupsDisplay)">Groups</MudTableSortLabel></MudTh>
                        <MudTh>
                            <FieldWithHelp Topic="Client portal" Inline="true" Help="This person sees a simplified, branded view of their Groups' domains instead of dotMARC. Use it for client contacts. Only for roles limited to Groups, and the grant must have at least one Group.">
                                Client portal
                            </FieldWithHelp>
                        </MudTh>
                        <MudTh></MudTh>
                    </tr>
                    @if (_showGrantFilters)
                    {
                    <tr>
                        <MudTh><MudTextField T="string" @bind-Value="_grantEmailFilter" Placeholder="Search" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" /></MudTh>
                        <MudTh>
                            <MudSelect T="bool?" Value="_grantIsBoundFilter" ValueChanged="@(v => _grantIsBoundFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                                <MudSelectItem T="bool?" Value="true">Active</MudSelectItem>
                                <MudSelectItem T="bool?" Value="false">Pending first sign-in</MudSelectItem>
                            </MudSelect>
                        </MudTh>
                        <MudTh>
                            <MudSelect T="string" Value="_grantRoleFilter" ValueChanged="@(v => _grantRoleFilter = v)" Clearable="true" Placeholder="Any" Margin="Margin.Dense">
                                @foreach (var roleName in _grants.Select(g => g.RoleName).Distinct().OrderBy(n => n))
                                {
                                    <MudSelectItem T="string" Value="roleName">@roleName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTh>
                        <MudTh><MudTextField T="string" @bind-Value="_grantGroupsFilter" Placeholder="Search" Immediate="true" Margin="Margin.Dense" /></MudTh>
                        <MudTh></MudTh>
                        <MudTh></MudTh>
                    </tr>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Email</MudTd>
                    <MudTd>@(context.IsBound ? "Active" : "Pending first sign-in")</MudTd>
                    <MudTd>
                        <MudSelect T="int" Value="context.RoleId" ValueChanged="@(roleId => ChangeRoleAsync(context, roleId))" Dense="true" Margin="Margin.Dense"
                                   UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = $"Role for {context.Email}" })">
                            @foreach (var role in _roles ?? [])
                            {
                                <MudSelectItem T="int" Value="role.Id">@role.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd>
                        @if (context.RoleIsScopable)
                        {
                            <SearchableMultiSelect TValue="int" Options="_groupOptions" SelectedValues="context.ScopedGroupIds"
                                                   SelectedValuesChanged="@(ids => ChangeGroupsAsync(context, ids))"
                                                   MultiSelectionTextFunc="@(selected => selected.Count == 0 ? "All (unrestricted)" : string.Join(", ", selected))" />
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">All (role isn't limited to groups)</MudText>
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.RoleIsScopable)
                        {
                            <MudSwitch T="bool" Value="context.IsClientPortal" ValueChanged="@(isClientPortal => SetClientPortalAsync(context, isClientPortal))"
                                       Color="Color.Primary" UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = $"Client portal for {context.Email}" })" />
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Not available</MudText>
                        }
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => RevokeAccessAsync(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else if (_grants is not null)
        {
            <MudText Typo="Typo.body2" Class="mt-4">No one has been granted access yet.</MudText>
        }
        </div>
    </MudTabPanel>
    <MudTabPanel Text="Roles" Icon="@Icons.Material.Filled.Badge">
        <div class="pt-4">
        <MudGrid>
            <MudItem xs="6">
                <MudTextField @bind-Value="_newRoleName" Label="Role name" Placeholder="Domain Manager" Variant="Variant.Outlined"
                              Error="@(_addRoleError is not null)" ErrorText="@_addRoleError" Immediate="true" />
            </MudItem>
            <MudItem xs="3" Class="d-flex align-center">
                <FieldWithHelp Topic="Limit to groups" Help="@LimitToGroupsHelp">
                    <MudSwitch T="bool" @bind-Value="_newRoleLimitedToGroups" Color="Color.Primary" Label="Limit to groups" />
                </FieldWithHelp>
            </MudItem>
            <MudItem xs="3" Class="d-flex align-start">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="button-beside-input" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddRoleAsync">Add role</MudButton>
            </MudItem>
        </MudGrid>

        @if (_roles is { Count: > 0 })
        {
            <MudTable Items="_roles" Hover="true" T="RoleRow" Class="mt-4" CustomHeader="true" Filter="RoleMatchesFilters">
                <ToolBarContent>
                    <MudSpacer />
                    <MudButton Variant="@(_showRoleFilters ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList"
                               OnClick="@(() => _showRoleFilters = !_showRoleFilters)">@(_showRoleFilters ? "Hide filters" : "Filters")</MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <tr>
                        <MudTh><MudTableSortLabel SortBy="new Func<RoleRow, object>(r => r.Name)">Name</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<RoleRow, object>(r => r.IsLocked ? int.MaxValue : r.Permissions.Count)">Permissions</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<RoleRow, object>(r => r.IsScopable)">Limited to groups</MudTableSortLabel></MudTh>
                        <MudTh></MudTh>
                    </tr>
                    @if (_showRoleFilters)
                    {
                    <tr>
                        <MudTh><MudTextField T="string" @bind-Value="_roleNameFilter" Placeholder="Search" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" /></MudTh>
                        <MudTh>
                            <MudSelect T="Permission?" Value="_rolePermissionFilter" ValueChanged="@(v => _rolePermissionFilter = v)" Clearable="true" Placeholder="Has permission" Margin="Margin.Dense">
                                @foreach (var permission in Enum.GetValues<Permission>())
                                {
                                    <MudSelectItem T="Permission?" Value="permission">@permission</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTh>
                        <MudTh></MudTh>
                        <MudTh></MudTh>
                    </tr>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @if (context.IsLocked)
                        {
                            <MudText>@context.Name</MudText>
                        }
                        else
                        {
                            <MudTextField T="string" Value="context.Name" ValueChanged="@(v => RenameRoleAsync(context, v))" />
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.IsLocked)
                        {
                            <MudText Typo="Typo.body2">All permissions</MudText>
                        }
                        else
                        {
                            <MudSelect T="Permission" MultiSelection="true" SelectedValues="context.Permissions"
                                       SelectedValuesChanged="@(p => SetRolePermissionsAsync(context, p))"
                                       MultiSelectionTextFunc="@(selected => selected.Count == 0 ? "None" : $"{selected.Count} permission(s)")"
                                       RelativeWidth="DropdownWidth.Adaptive">
                                @foreach (var permission in Enum.GetValues<Permission>().Where(permission => !context.IsScopable || GroupLimits.IsAllowed(permission)))
                                {
                                    <MudSelectItem T="Permission" Value="permission">@permission</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.IsLocked)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Never</MudText>
                        }
                        else
                        {
                            <MudSwitch T="bool" Value="context.IsScopable" ValueChanged="@(limited => SetLimitedToGroupsAsync(context, limited))" Color="Color.Primary"
                                       UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = $"Limit {context.Name} to groups" })" />
                        }
                    </MudTd>
                    <MudTd>
                        @if (!context.IsLocked)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteRoleAsync(context))" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        </div>
    </MudTabPanel>
    <MudTabPanel Text="API keys" Icon="@Icons.Material.Filled.Key">
        <div class="pt-4">
        <ApiKeysSection />
        </div>
    </MudTabPanel>
</MudTabs>
</MudPaper>

@code {
    private List<RoleRow>? _roles;
    private List<GrantRow>? _grants;
    private List<Group> _allGroups = [];
    private List<SelectOption<int>> _groupOptions = [];
    private string _newRoleName = "";
    private string? _addRoleError;
    private bool _newRoleLimitedToGroups;

    private const string LimitToGroupsHelp = "Someone granted this role with Groups sees and manages only those Groups' domains. "
        + "It can only hold permissions that stay within their Groups: viewing, adding, editing and removing domains, MTA-STS, viewing groups and tags, alerts, client reports and the audit log. "
        + "Settings pages that cover every client stay closed to them. "
        + "It can only be switched on or off while no one holds the role.";
    private string _newGrantEmail = "";
    private int _newGrantRoleId;
    private IReadOnlyCollection<int> _newGrantGroupIds = [];
    private string? _addGrantError;
    private bool _inviteAsGuest = true;

    private const string InviteAsGuestHelp = "Someone from outside your organisation can only sign in once they're a guest in your Entra tenant. "
        + "With this ticked, dotMARC adds them as a guest for you, without Microsoft's invitation email: send them dotMARC's address, and they accept the first time they sign in. "
        + "Untick it for people already in your tenant. Needs the dashboard app registration to hold the User.Invite.All application permission.";

    private string? _roleNameFilter;
    private Permission? _rolePermissionFilter;
    private bool _showRoleFilters;

    private string? _grantEmailFilter;
    private bool? _grantIsBoundFilter;
    private string? _grantRoleFilter;
    private string? _grantGroupsFilter;
    private bool _showGrantFilters;

    private bool RoleMatchesFilters(RoleRow row)
    {
        if (!string.IsNullOrWhiteSpace(_roleNameFilter) && !row.Name.Contains(_roleNameFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        // Locked roles show "All permissions", so they match whichever permission is picked.
        if (_rolePermissionFilter is { } permission && !row.IsLocked && !row.Permissions.Contains(permission))
        {
            return false;
        }
        return true;
    }

    private bool GrantMatchesFilters(GrantRow row)
    {
        if (!string.IsNullOrWhiteSpace(_grantEmailFilter) && !row.Email.Contains(_grantEmailFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (_grantIsBoundFilter is { } isBound && row.IsBound != isBound)
        {
            return false;
        }
        if (_grantRoleFilter is not null && row.RoleName != _grantRoleFilter)
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_grantGroupsFilter) && !row.ScopedGroupsDisplay.Contains(_grantGroupsFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        return true;
    }

    private static readonly string[] TabSlugs = ["people", "roles", "api-keys"];

    [Parameter]
    public string? Tab { get; set; }

    private int _activeTabIndex;

    protected override void OnParametersSet()
    {
        var index = Tab is null ? -1 : Array.IndexOf(TabSlugs, Tab.ToLowerInvariant());
        _activeTabIndex = index >= 0 ? index : 0;
    }

    private void OnActiveTabIndexChanged(int index)
    {
        _activeTabIndex = index;
        var slug = TabSlugs[index >= 0 && index < TabSlugs.Length ? index : 0];
        Navigation.NavigateTo($"/access/{slug}", replace: true);
    }

    private bool SelectedNewGrantRoleIsScopable => _roles?.SingleOrDefault(r => r.Id == _newGrantRoleId)?.IsScopable ?? false;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _allGroups = await db.Groups.AsNoTracking().OrderBy(g => g.Name).ToListAsync();
        _groupOptions = _allGroups.Select(group => new SelectOption<int>(group.Id, group.Name)).ToList();
        _roles = await db.Roles
            .AsNoTracking()
            .OrderBy(r => r.Name)
            .Select(r => new RoleRow(r.Id, r.Name, r.IsLocked, r.IsScopable, r.Permissions))
            .ToListAsync();
        _grants = await db.UserAccesses
            .AsNoTracking()
            // Two collections are projected (the Groups' ids and names), so without this EF joins them into one result set.
            .AsSplitQuery()
            .OrderBy(u => u.Email)
            .Select(u => new GrantRow(u.Id, u.Email, u.EntraObjectId != null, u.RoleId, u.Role.Name, u.ScopedGroups.Select(g => g.Id).ToList(),
                u.ScopedGroups.Select(g => g.Name).ToList(), u.Role.IsScopable, u.IsClientPortal))
            .ToListAsync();

        if (_newGrantRoleId == 0 && _roles.Count > 0)
        {
            _newGrantRoleId = _roles[0].Id;
        }
    }

    private async Task AddRoleAsync()
    {
        _addRoleError = null;
        RoleManagementService.AddRoleResult result;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            result = await RoleManagementService.AddRoleAsync(db, await AuditActorAccessor.GetAsync(), _newRoleName, [], CancellationToken.None, _newRoleLimitedToGroups);
        }
        catch (Exception)
        {
            _addRoleError = "Something went wrong adding the role. Try again.";
            return;
        }

        _addRoleError = result switch
        {
            RoleManagementService.AddRoleResult.InvalidName => "Enter a role name.",
            RoleManagementService.AddRoleResult.AlreadyExists => "A role with that name already exists.",
            _ => null
        };

        if (result == RoleManagementService.AddRoleResult.Added)
        {
            _newRoleName = "";
            _newRoleLimitedToGroups = false;
            await LoadAsync();
        }
    }

    private async Task RenameRoleAsync(RoleRow row, string newName)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await RoleManagementService.UpdateRoleAsync(db, await AuditActorAccessor.GetAsync(), row.Id, newName, row.Permissions, CancellationToken.None);
            if (result != RoleManagementService.UpdateRoleResult.Updated)
            {
                Snackbar.Add("Failed to rename role - the name may be empty or already taken.", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to rename {row.Name}. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    /// <summary>A saved change updates the row in place rather than reloading the table: reloading replaces every row,
    /// which rebuilds the permission picker and closes it after each tick.</summary>
    private async Task SetRolePermissionsAsync(RoleRow row, IEnumerable<Permission> permissions)
    {
        var chosen = permissions.ToList();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await RoleManagementService.UpdateRoleAsync(db, await AuditActorAccessor.GetAsync(), row.Id, row.Name, chosen, CancellationToken.None);
            if (result == RoleManagementService.UpdateRoleResult.Updated)
            {
                row.Permissions.Clear();
                row.Permissions.AddRange(chosen);
                return;
            }

            Snackbar.Add(result == RoleManagementService.UpdateRoleResult.NotAllowedWhenLimited
                ? $"{row.Name} is limited to groups, so it can only hold permissions that stay within its Groups."
                : $"Failed to update {row.Name}'s permissions - the role may have been renamed or locked elsewhere. Try again.", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to update {row.Name}'s permissions. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    private async Task SetLimitedToGroupsAsync(RoleRow row, bool limitedToGroups)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await RoleManagementService.SetLimitedToGroupsAsync(db, await AuditActorAccessor.GetAsync(), row.Id, limitedToGroups, CancellationToken.None);
            var error = result switch
            {
                RoleManagementService.SetLimitedToGroupsResult.InUse => $"Can't change {row.Name} while it's granted to someone or an API key. Create a new role instead, or revoke those first.",
                RoleManagementService.SetLimitedToGroupsResult.NotAllowedWhenLimited => $"Can't limit {row.Name} to groups while it holds permissions that reach past its Groups. Remove those first.",
                RoleManagementService.SetLimitedToGroupsResult.Locked => $"{row.Name} can't be changed.",
                _ => null,
            };
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to update {row.Name}. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    private async Task DeleteRoleAsync(RoleRow row)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await RoleManagementService.RemoveRoleAsync(db, await AuditActorAccessor.GetAsync(), row.Id, CancellationToken.None);
            if (result == RoleManagementService.RemoveRoleResult.InUse)
            {
                Snackbar.Add($"Can't remove {row.Name}. It's still granted to at least one person or API key. Revoke or reassign those first.", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to remove {row.Name}. Try again.", Severity.Error);
        }
        await LoadAsync();
    }

    private async Task GrantAccessAsync()
    {
        _addGrantError = null;
        UserAccessManagementService.GrantAccessResult result;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            result = await UserAccessManagementService.GrantAccessAsync(db, await AuditActorAccessor.GetAsync(), _newGrantEmail, _newGrantRoleId, _newGrantGroupIds.ToList(), CancellationToken.None);
        }
        catch (Exception)
        {
            _addGrantError = "Something went wrong granting access. Try again.";
            return;
        }

        _addGrantError = result switch
        {
            UserAccessManagementService.GrantAccessResult.InvalidEmail => "Enter an email address.",
            UserAccessManagementService.GrantAccessResult.AlreadyExists => "That email already has access.",
            UserAccessManagementService.GrantAccessResult.RoleNotFound => "Choose a role.",
            _ => null
        };

        if (result == UserAccessManagementService.GrantAccessResult.Granted)
        {
            var email = _newGrantEmail.Trim();
            _newGrantEmail = "";
            _newGrantGroupIds = [];
            await LoadAsync();
            if (_inviteAsGuest && GuestInviter.IsAvailable)
            {
                await InviteAsGuestAsync(email);
            }
        }
    }

    /// <summary>Access is already granted by now, so however the invite goes, it only adds a message.</summary>
    private async Task InviteAsGuestAsync(string email)
    {
        var invite = await GuestInviter.InviteAsync(email, Navigation.BaseUri, CancellationToken.None);
        switch (invite.Outcome)
        {
            case DotMarc.Graph.GuestInviteOutcome.Invited:
                await AuditRecorder.RecordAsync(DotMarc.Audit.AuditLog.Create(await AuditActorAccessor.GetAsync(), DotMarc.Audit.AuditEntryKind.Change,
                    DotMarc.Audit.AuditActions.GuestInvited, null, $"Added {email} to Entra as a guest"));
                Snackbar.Add($"Added {email} to Entra as a guest. Send them dotMARC's address; they'll accept the invitation the first time they sign in.", Severity.Success);
                break;
            case DotMarc.Graph.GuestInviteOutcome.Refused:
                Snackbar.Add($"Access granted, but Entra didn't invite {email}: {invite.Detail ?? "no reason given"}. If they're already in your tenant, that's fine.", Severity.Warning);
                break;
            case DotMarc.Graph.GuestInviteOutcome.NotPermitted:
                Snackbar.Add($"Access granted, but dotMARC isn't allowed to invite guests yet. In Entra, give the dashboard app registration the Microsoft Graph application permission User.Invite.All and grant admin consent, then invite {email} by hand or revoke and grant again.", Severity.Warning);
                break;
            default:
                Snackbar.Add($"Access granted, but inviting {email} to Entra failed{(invite.Detail is null ? "" : $": {invite.Detail}")}. Invite them in Entra by hand.", Severity.Warning);
                break;
        }
    }

    private async Task ChangeRoleAsync(GrantRow row, int roleId)
    {
        var newRoleIsLimited = _roles?.SingleOrDefault(role => role.Id == roleId)?.IsScopable == true;
        // A grant's Groups only count on a role limited to groups, so they carry over only from one such role to another.
        var groupIds = row.RoleIsScopable && newRoleIsLimited ? row.ScopedGroupIds : [];
        if (await UpdateAccessAsync(row, roleId, groupIds) && newRoleIsLimited && groupIds.Count == 0)
        {
            Snackbar.Add($"Now choose {row.Email}'s Groups. Until you do, they see every domain.", Severity.Info);
        }
    }

    private Task ChangeGroupsAsync(GrantRow row, IEnumerable<int> groupIds) => UpdateAccessAsync(row, row.RoleId, groupIds.ToList());

    private async Task<bool> UpdateAccessAsync(GrantRow row, int roleId, IReadOnlyList<int> groupIds)
    {
        var updated = false;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await UserAccessManagementService.UpdateAccessAsync(db, await AuditActorAccessor.GetAsync(), row.Id, roleId, groupIds, CancellationToken.None);
            updated = result == UserAccessManagementService.UpdateAccessResult.Updated;
            var error = result switch
            {
                UserAccessManagementService.UpdateAccessResult.LastAdminGuard => $"Can't change {row.Email}'s access: no one else could manage access. Give someone else that first.",
                UserAccessManagementService.UpdateAccessResult.ClientPortalNeedsGroups => $"{row.Email} uses the client portal, which needs a role limited to groups and at least one Group. Turn the portal off first.",
                UserAccessManagementService.UpdateAccessResult.RoleNotFound => "That role no longer exists.",
                _ => null,
            };
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to change access for {row.Email}. Try again.", Severity.Error);
        }

        await LoadAsync();
        return updated;
    }

    private async Task SetClientPortalAsync(GrantRow row, bool isClientPortal)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await UserAccessManagementService.SetClientPortalAsync(db, await AuditActorAccessor.GetAsync(), row.Id, isClientPortal, CancellationToken.None);
            if (result == UserAccessManagementService.SetClientPortalResult.NeedsScopedGroups)
            {
                Snackbar.Add("A client portal grant must be limited to the client's Groups.", Severity.Warning);
            }
            else
            {
                Snackbar.Add(isClientPortal ? $"{row.Email} now sees the client portal." : $"{row.Email} now sees dotMARC.", Severity.Success);
            }
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to change the client portal for {row.Email}. Try again.", Severity.Error);
        }

        await LoadAsync();
    }

    private async Task RevokeAccessAsync(GrantRow row)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await UserAccessManagementService.RevokeAccessAsync(db, await AuditActorAccessor.GetAsync(), row.Id, CancellationToken.None);
            if (result == UserAccessManagementService.RevokeAccessResult.LastAdminGuard)
            {
                Snackbar.Add($"Can't revoke {row.Email} - they're the last remaining grant with Manage Access permission. Grant Manage Access to someone else first.", Severity.Error);
                return;
            }
            await LoadAsync();
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to revoke access for {row.Email}. Try again.", Severity.Error);
        }
    }

    private sealed record RoleRow(int Id, string Name, bool IsLocked, bool IsScopable, List<Permission> Permissions);

    private sealed record GrantRow(int Id, string Email, bool IsBound, int RoleId, string RoleName, List<int> ScopedGroupIds, List<string> ScopedGroupNames, bool RoleIsScopable, bool IsClientPortal)
    {
        public string ScopedGroupsDisplay => ScopedGroupNames.Count == 0 ? "All" : string.Join(", ", ScopedGroupNames);
    }
}

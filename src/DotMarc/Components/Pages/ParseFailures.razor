@page "/parse-failures"
@attribute [Authorize(Policy = "ParseFailuresView")]
@using DotMarc.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DotMarcDbContext> DbFactory

<PageTitle>dotMARC - Message Parse Failures</PageTitle>
<MudButton Href="/dashboard" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">Back</MudButton>
<MudText Typo="Typo.h4" Class="mb-4">Unparseable messages</MudText>

@if (_failures is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_failures.Count == 0)
{
    <MudText>No unparseable messages - every mailbox message has been parsed successfully.</MudText>
}
else
{
    <MudTable Items="_failures" Hover="true" T="ParseFailure" CustomHeader="true" Filter="FailureMatchesFilters">
        <ToolBarContent>
            <MudSpacer />
            <MudButton Variant="@(_showFilters ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList"
                       OnClick="@(() => _showFilters = !_showFilters)">@(_showFilters ? "Hide filters" : "Filters")</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <tr>
                <MudTh><MudTableSortLabel SortBy="new Func<ParseFailure, object>(f => f.Subject ?? f.GraphMessageId)">Email</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ParseFailure, object>(f => f.Reason)">Reason</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ParseFailure, object>(f => f.AttemptCount)">Attempts</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ParseFailure, object>(f => f.LastAttemptedUtc)">Last attempted</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ParseFailure, object>(f => f.GaveUpUtc is null)">Status</MudTableSortLabel></MudTh>
            </tr>
            @if (_showFilters)
            {
            <tr>
                <MudTh><MudTextField T="string" @bind-Value="_messageIdFilter" Placeholder="Search" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" /></MudTh>
                <MudTh><MudTextField T="string" @bind-Value="_reasonFilter" Placeholder="Search" Immediate="true" Margin="Margin.Dense" /></MudTh>
                <MudTh><MudNumericField T="int?" @bind-Value="_minAttemptsFilter" Placeholder="Min" Margin="Margin.Dense" Min="0" /></MudTh>
                <MudTh><MudTextField T="string" @bind-Value="_lastAttemptedFilter" Placeholder="Search" Immediate="true" Margin="Margin.Dense" /></MudTh>
                <MudTh></MudTh>
            </tr>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="overflow-wrap:anywhere">
                @if (!string.IsNullOrWhiteSpace(context.Subject))
                {
                    <div>@context.Subject</div>
                }
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.GraphMessageId</MudText>
            </MudTd>
            <MudTd>@context.Reason</MudTd>
            <MudTd>@context.AttemptCount</MudTd>
            <MudTd>@DotMarc.Reporting.UkTime.DateTime(context.LastAttemptedUtc)</MudTd>
            <MudTd>
                @if (context.GaveUpUtc is { } gaveUp)
                {
                    <MudTooltip Text="@($"Stopped retrying on {DotMarc.Reporting.UkTime.DateTime(gaveUp)} and marked the email read.")" Arrow="true">
                        <MudChip T="string" Size="Size.Small">Gave up</MudChip>
                    </MudTooltip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Retrying</MudChip>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<ParseFailure>? _failures;

    private string? _messageIdFilter;
    private string? _reasonFilter;
    private int? _minAttemptsFilter;
    private string? _lastAttemptedFilter;
    private bool _showFilters;

    private bool FailureMatchesFilters(ParseFailure failure)
    {
        if (!string.IsNullOrWhiteSpace(_messageIdFilter) && !failure.GraphMessageId.Contains(_messageIdFilter, StringComparison.OrdinalIgnoreCase) && !(failure.Subject ?? "").Contains(_messageIdFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_reasonFilter) && !(failure.Reason ?? "").Contains(_reasonFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        if (_minAttemptsFilter is { } minAttempts && failure.AttemptCount < minAttempts)
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(_lastAttemptedFilter) && !DotMarc.Reporting.UkTime.DateTime(failure.LastAttemptedUtc).Contains(_lastAttemptedFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }
        return true;
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _failures = await db.ParseFailures
            .AsNoTracking()
            .OrderByDescending(f => f.LastAttemptedUtc)
            .ToListAsync();
    }
}

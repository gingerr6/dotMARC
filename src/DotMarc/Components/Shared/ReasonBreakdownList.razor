@using DotMarc.Reporting
@* The reject/quarantine reason counts as a bulleted list, in the same order as the donut chart's legend. Reasons
   with no messages stay in the list (so "none of these" is visible) but are dimmed. Shared by the Dashboard and the
   domain page so both read the same. *@
@* One root element, so a flex parent (both pages centre this vertically in a flex row) doesn't lay the heading and the
   list out side by side. *@
<div>
    <MudText Typo="Typo.body2" Class="mb-1">Of @Breakdown.Total rejected/quarantined messages:</MudText>
    <ul class="reason-list">
        @foreach (var reason in Reasons)
        {
            <li class="@(reason.Count == 0 ? "reason-none" : null)">
                <strong>@reason.Count</strong> @reason.Description
                @if (reason.Domains.Count > 0)
                {
                    @* Which domains, so a count across every domain can be followed up: each opens that domain's Sources tab. *@
                    <span class="reason-domains">
                        &ndash;
                        @foreach (var (domain, index) in reason.Domains.Take(MaxDomainsShown).Select((domain, index) => (domain, index)))
                        {
                            @(index > 0 ? ", " : "")<a href="@($"/domains/{Uri.EscapeDataString(domain.DomainName)}/sources")">@domain.DomainName</a>@(reason.Domains.Count > 1 ? $" ({domain.Count})" : "")
                        }
                        @if (reason.Domains.Count > MaxDomainsShown)
                        {
                            @($" and {reason.Domains.Count - MaxDomainsShown} more")
                        }
                    </span>
                }
            </li>
        }
    </ul>
</div>

@code {
    private const int MaxDomainsShown = 5;

    [Parameter, EditorRequired] public ReasonBreakdown Breakdown { get; set; } = default!;

    /// <summary>The domains behind each count, on the dashboard where the counts span every domain. Left out on a
    /// domain's own page.</summary>
    [Parameter] public ReasonDomains? Domains { get; set; }

    private IEnumerable<(int Count, string Description, IReadOnlyList<ReasonDomainCount> Domains)> Reasons
    {
        get
        {
            var domains = Domains ?? ReasonDomains.Empty;
            return
            [
                (Breakdown.BenignOverride, "benign override (forwarders and mailing lists)", domains.BenignOverride),
                (Breakdown.LocalPolicy, "local policy", domains.LocalPolicy),
                (Breakdown.Other, "other", domains.Other),
                (Breakdown.InferredSpfFailure, "inferred SPF-only failure", domains.InferredSpfFailure),
                (Breakdown.InferredDkimFailure, "inferred DKIM-only failure", domains.InferredDkimFailure),
                (Breakdown.InferredBothFailure, "inferred SPF and DKIM both failing", domains.InferredBothFailure),
                (Breakdown.NoReasonGiven, "no reason given", domains.NoReasonGiven),
            ];
        }
    }
}

@using DotMarc.Components.Dialogs
@using DotMarc.Data
@using DotMarc.DnsPush
@using DotMarc.Ingestion
@using DotMarc.MtaSts
@using DotMarc.Reporting
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@inject AuditActorAccessor AuditActorAccessor
@inject IDbContextFactory<DotMarcDbContext> DbFactory
@inject IOptions<MtaStsOptions> MtaStsOptions
@inject IMxHostsLookup MxHostsLookup
@inject IMtaStsCnameLookup MtaStsCnameLookup
@inject IMtaStsHostProvisioner MtaStsHostProvisioner
@inject IMtaStsDnsVerifier MtaStsDnsVerifier
@inject IMtaStsServingVerifier MtaStsServingVerifier
@inject IEnumerable<IDnsPushProvider> DnsPushProviders
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudPaper Class="pa-4 my-2" Elevation="1">
    @if (string.IsNullOrEmpty(MtaStsOptions.Value.HostingHostname))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            MTA-STS hosting isn't configured on this deployment yet, so enabling this domain won't
            progress past "Waiting for DNS."
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.subtitle2" Class="mb-1">DNS records MTA-STS needs (both)</MudText>
        <MudSimpleTable Dense="true" Elevation="0" Class="mb-3">
            <thead><tr><th></th><th>Type</th><th>Name</th><th>Value</th><th></th></tr></thead>
            <tbody>
                <tr>
                    <td>@RecordIcon(_cnameOk)</td>
                    <td>CNAME</td>
                    <td><code>mta-sts.@Domain.Name</code></td>
                    <td><code>@MtaStsOptions.Value.HostingHostname</code><div class="mud-text-secondary" style="font-size:12px">Where the policy is hosted</div></td>
                    <td><MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" title="Copy value" OnClick="@(() => CopyAsync(MtaStsOptions.Value.HostingHostname!))" /></td>
                </tr>
                <tr>
                    <td>@RecordIcon(_txtOk)</td>
                    <td>TXT</td>
                    <td><code>_mta-sts.@Domain.Name</code></td>
                    <td>
                        <code>@PolicyRecord</code>
                        <div class="mud-text-secondary" style="font-size:12px">Tells senders there's a policy. The id changes when the policy does: update it here after changing the mode, MX hosts or max age.</div>
                        @if (_txtDetail is not null)
                        {
                            <div style="font-size:12px" class="mud-warning-text">@_txtDetail</div>
                        }
                    </td>
                    <td><MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" title="Copy value" OnClick="@(() => CopyAsync(PolicyRecord))" /></td>
                </tr>
                @if (!string.IsNullOrEmpty(_domainVerificationId))
                {
                    <tr>
                        <td></td>
                        <td>TXT</td>
                        <td><code>asuid.mta-sts.@Domain.Name</code></td>
                        <td><code>@_domainVerificationId</code><div class="mud-text-secondary" style="font-size:12px">Azure's proof that you control the domain</div></td>
                        <td><MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" title="Copy value" OnClick="@(() => CopyAsync(_domainVerificationId!))" /></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
    <div class="d-flex align-center mb-2">
        <MudText Typo="Typo.subtitle1">Policy hosting status</MudText>
        <DocsLink Href="https://dotmarc.app/docs/mta-sts#status" Text="What do these statuses mean?" Class="ml-2" />
        <MudSpacer />
        @if (Domain.MtaStsEnabled)
        {
            <AuthorizeView Policy="MtaStsManage" Context="mtaStsRecheckAuthState">
                <Authorized>
                    @if (_isRechecking)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RecheckAsync" title="Recheck now" />
                    }
                </Authorized>
            </AuthorizeView>
        }
    </div>
    <MudChip T="string" Color="@MtaStsStatusPresentation.GetColor(Domain.MtaStsStatus, Domain.MtaStsMode)" Size="Size.Small">@MtaStsStatusPresentation.GetLabel(Domain.MtaStsStatus, Domain.MtaStsMode)</MudChip>
    @if (Domain.MtaStsCheckedUtc is { } checkedUtc)
    {
        <MudText Typo="Typo.caption" Class="mt-1">Last checked: @DotMarc.Reporting.UkTime.DateTimeSeconds(checkedUtc)</MudText>
    }
    @if (!string.IsNullOrWhiteSpace(Domain.MtaStsCheckDetail))
    {
        <MudText Typo="Typo.body2" Class="mt-1">@Domain.MtaStsCheckDetail</MudText>
    }

    <AuthorizeView Policy="MtaStsManage" Context="manageAuthState">
        <div class="mt-3">
            @if (!_enabled)
            {
                @if (_isEnabling)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="EnableAsync">Enable MTA-STS</MudButton>
                }
            }
            else
            {
                @if (MayPush && (Domain.MtaStsStatus is MtaStsStatus.PendingDns or MtaStsStatus.PendingCertificate or MtaStsStatus.Failed or MtaStsStatus.PendingPolicyRecord || _txtOk == false))
                {
                    @if (_isPushing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudSync" OnClick="PushDnsRecordsAsync">Push DNS records via your DNS provider</MudButton>
                    }
                }
            }

            @if (Domain.MtaStsEnabled && Domain.MtaStsMxHosts.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">
                    MTA-STS is on, but it has no MX hosts, so the policy dotMARC serves lists no mail servers and senders that
                    check it may refuse to deliver.
                    @(_mxHostsFromDns ? "The MX hosts below were looked up from DNS. Check them and select Save." : "Add the domain's MX hosts below and select Save.")
                </MudAlert>
            }

            <MudExpansionPanels Class="mt-3">
                <MudExpansionPanel Text="Advanced" @bind-Expanded="_advancedExpanded">
                    <FieldWithHelp Topic="MTA-STS hosting" Inline="true" Help="Whether dotMARC hosts this domain's MTA-STS policy. Saving it off stops serving the policy and removes the mta-sts hostname from the host.">
<MudSwitch T="bool" @bind-Value="_enabled" Label="Enabled" Color="Color.Primary" Class="mb-2" />
</FieldWithHelp>
                    <FieldWithHelp Topic="MTA-STS mode" Help="Testing: receivers report TLS problems (through TLS-RPT) but still deliver. Enforce: receivers refuse to deliver over a connection that fails the policy. None: tells receivers to stop applying a policy they cached earlier.">
<MudSelect T="MtaStsMode" @bind-Value="_mode" Label="Mode">
                        <MudSelectItem T="MtaStsMode" Value="MtaStsMode.Testing">Testing</MudSelectItem>
                        <MudSelectItem T="MtaStsMode" Value="MtaStsMode.Enforce">Enforce</MudSelectItem>
                        <MudSelectItem T="MtaStsMode" Value="MtaStsMode.None">None</MudSelectItem>
                    </MudSelect>
</FieldWithHelp>
                    <FieldWithHelp Topic="Max age" Help="How long receivers may cache the policy, in seconds. 604800 is 7 days. Lower it for a while before changing MX records.">
<MudNumericField T="int" @bind-Value="_maxAgeSeconds" Label="Max age (seconds)" Min="0" Class="mt-2" />
</FieldWithHelp>
                    <MudTextField @bind-Value="_mxHostsText" Label="MX hosts" Lines="3" Class="mt-2"
                                  HelperText="@(_mxHostsFromDns ? "Filled in from the domain's MX records in DNS. Select Save to use them." : "One per line, e.g. mail.example.com")" />
                    <div class="d-flex mt-2" style="gap:0.5rem">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveAdvancedAsync">Save</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Dns" Disabled="_isLookingUpMx"
                                   OnClick="LookUpMxHostsAsync">Look up from DNS</MudButton>
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </div>
    </AuthorizeView>
</MudPaper>

@code {
    [Parameter, EditorRequired] public Domain Domain { get; set; } = default!;

    /// <summary>Whether this person may push the records (see DomainDetail); otherwise they copy them from the table.</summary>
    [Parameter] public bool MayPush { get; set; } = true;
    [Parameter, EditorRequired] public Func<string, int, string, Task> OpenDnsPushPopup { get; set; } = default!;

    private bool _enabled;
    private MtaStsMode _mode;
    private int _maxAgeSeconds;
    private string _mxHostsText = "";
    private bool _isEnabling;
    private bool _isPushing;
    private bool _isRechecking;
    private int _syncedDomainId;
    private string? _domainVerificationId;
    private bool _mxHostsFromDns;
    private bool _isLookingUpMx;
    private bool _advancedExpanded;
    private bool? _cnameOk;
    private bool? _txtOk;
    private string? _txtDetail;

    private string PolicyRecord => MtaStsPolicyRenderer.PolicyRecord(MtaStsPolicyRenderer.PolicyId(Domain.MtaStsMode, Domain.MtaStsMxHosts, Domain.MtaStsMaxAgeSeconds));

    private static RenderFragment RecordIcon(bool? ok) => ok switch
    {
        true => @<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" title="Found in DNS" />,
        false => @<MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" title="Not right in DNS yet" />,
        _ => @<MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" title="Checking…" />
    };

    private async Task CopyAsync(string value)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
        Snackbar.Add("Copied.", Severity.Success);
    }

    /// <summary>Checks both records in live DNS, for the ticks beside them.</summary>
    private async Task CheckRecordsAsync()
    {
        var hostingHostname = MtaStsOptions.Value.HostingHostname;
        if (string.IsNullOrEmpty(hostingHostname))
        {
            return;
        }

        try
        {
            _cnameOk = await MtaStsDnsVerifier.VerifyAsync(Domain.Name, hostingHostname, CancellationToken.None) == MtaStsDnsVerificationResult.Resolved;
            var record = await MtaStsDnsVerifier.CheckPolicyRecordAsync(Domain.Name, CancellationToken.None);
            var expectedId = MtaStsPolicyRenderer.PolicyId(Domain.MtaStsMode, Domain.MtaStsMxHosts, Domain.MtaStsMaxAgeSeconds);
            _txtOk = record.State == MtaStsPolicyRecordState.Present && record.Id == expectedId;
            _txtDetail = record.State switch
            {
                MtaStsPolicyRecordState.Missing => "Not found in DNS yet.",
                MtaStsPolicyRecordState.Multiple => "There's more than one v=STSv1 record; keep only this one.",
                MtaStsPolicyRecordState.Invalid => "The record there has no valid id; replace it with this.",
                _ when record.Id != expectedId => $"Found with id={record.Id}; change it to this so senders fetch the current policy.",
                _ => null
            };
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _cnameOk = _txtOk = null;
        }
    }

    protected override void OnParametersSet()
    {
        if (_syncedDomainId == Domain.Id)
        {
            return;
        }
        _syncedDomainId = Domain.Id;
        _enabled = Domain.MtaStsEnabled;
        _mode = Domain.MtaStsMode;
        _maxAgeSeconds = Domain.MtaStsMaxAgeSeconds;
        _mxHostsText = string.Join('\n', Domain.MtaStsMxHosts);
    }

    protected override async Task OnInitializedAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await CheckRecordsAsync();
        }

        if (RendererInfo.IsInteractive && string.Equals(MtaStsOptions.Value.Provisioner, "Azure", StringComparison.OrdinalIgnoreCase))
        {
            _domainVerificationId = await MtaStsHostProvisioner.GetDomainVerificationIdAsync(CancellationToken.None);
        }

        // An empty MX list is filled in from DNS (unsaved), so it's ready to save rather than typed from memory. A domain
        // that's already on with no hosts is serving a policy that lists no mail servers, so Advanced opens to show it.
        if (RendererInfo.IsInteractive && Domain.MtaStsMxHosts.Count == 0)
        {
            await FillMxHostsFromDnsAsync(quiet: true);
            _advancedExpanded = Domain.MtaStsEnabled;
        }
    }

    private Task LookUpMxHostsAsync() => FillMxHostsFromDnsAsync(quiet: false);

    /// <summary>Puts the domain's MX records in the MX hosts field without saving them. Quiet means no message when
    /// nothing is found or the lookup fails, for the automatic fill on load.</summary>
    private async Task FillMxHostsFromDnsAsync(bool quiet)
    {
        _isLookingUpMx = true;
        try
        {
            var mxHosts = await MxHostsLookup.LookupAsync(Domain.Name, CancellationToken.None);
            if (mxHosts.Count > 0)
            {
                _mxHostsText = string.Join('\n', mxHosts);
                _mxHostsFromDns = true;
            }
            else if (!quiet)
            {
                Snackbar.Add($"No MX records found for {Domain.Name}.", Severity.Warning);
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (!quiet)
            {
                Snackbar.Add($"Couldn't look up {Domain.Name}'s MX records. Try again.", Severity.Error);
            }
        }
        finally
        {
            _isLookingUpMx = false;
        }
    }

    private async Task EnableAsync()
    {
        _isEnabling = true;
        var enabledSuccessfully = false;
        try
        {
            var mxHosts = await MxHostsLookup.LookupAsync(Domain.Name, CancellationToken.None);
            if (mxHosts.Count == 0)
            {
                Snackbar.Add($"No MX records found for {Domain.Name} - add them manually in Advanced before enabling.", Severity.Warning);
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            await DomainManagementService.SetMtaStsConfigAsync(db, await AuditActorAccessor.GetAsync(), Domain.Id, enabled: true, MtaStsMode.Testing, mxHosts, 604_800, CancellationToken.None);

            _enabled = true;
            _mode = MtaStsMode.Testing;
            _maxAgeSeconds = 604_800;
            _mxHostsText = string.Join('\n', mxHosts);
            Domain.MtaStsEnabled = true;
            Domain.MtaStsMode = MtaStsMode.Testing;
            Domain.MtaStsMaxAgeSeconds = 604_800;
            Domain.MtaStsMxHosts = mxHosts;
            Domain.MtaStsStatus = MtaStsStatus.PendingDns;

            Snackbar.Add($"MTA-STS enabled for {Domain.Name}.", Severity.Success);
            enabledSuccessfully = true;
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to enable MTA-STS for {Domain.Name}. Try again.", Severity.Error);
        }
        finally
        {
            _isEnabling = false;
        }

        if (enabledSuccessfully && MayPush)
        {
            await PushDnsRecordsAsync();
        }
    }

    private async Task SaveAdvancedAsync()
    {
        var mxHosts = _mxHostsText
            .Split(['\n', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await DomainManagementService.SetMtaStsConfigAsync(db, await AuditActorAccessor.GetAsync(), Domain.Id, _enabled, _mode, mxHosts, _maxAgeSeconds, CancellationToken.None);
            Domain.MtaStsEnabled = _enabled;
            Domain.MtaStsMode = _mode;
            Domain.MtaStsMaxAgeSeconds = _maxAgeSeconds;
            Domain.MtaStsMxHosts = mxHosts;
            _mxHostsFromDns = false;
            Snackbar.Add($"MTA-STS configuration saved for {Domain.Name}.", Severity.Success);
        }
        catch (ArgumentException refusal)
        {
            Snackbar.Add(refusal.Message.Split(" (Parameter")[0], Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add($"Failed to save {Domain.Name}'s MTA-STS configuration. Try again.", Severity.Error);
        }
    }

    private async Task PushDnsRecordsAsync()
    {
        _isPushing = true;
        try
        {
            var hostingHostname = MtaStsOptions.Value.HostingHostname;
            if (string.IsNullOrEmpty(hostingHostname))
            {
                Snackbar.Add("MTA-STS hosting isn't configured on this deployment.", Severity.Warning);
                return;
            }

            var providerKey = Domain.DnsProvider.ToProviderKey();
            var pushProvider = await DnsPushProviders.FindConfiguredAsync(providerKey);
            if (pushProvider is null)
            {
                Snackbar.Add(Domain.DnsProvider == DetectedDnsProvider.NotChecked
                    ? "This domain's DNS provider hasn't been checked yet - try the recheck button on the Overview tab, then push again."
                    : $"Couldn't find a configured DNS push option for {Domain.Name} - add the CNAME manually.", Severity.Warning);
                return;
            }

            string? existing;
            try
            {
                existing = await MtaStsCnameLookup.LookupAsync(Domain.Name, CancellationToken.None);
            }
            catch (Exception)
            {
                Snackbar.Add($"Failed to look up {Domain.Name}'s current MTA-STS CNAME. Try again.", Severity.Error);
                return;
            }

            var existingForComparison = existing is not null && string.Equals(existing, hostingHostname, StringComparison.OrdinalIgnoreCase)
                ? hostingHostname
                : existing;
            if (DnsRecordPushDecision.NeedsConfirmation(existingForComparison, delegatedToCname: null, hostingHostname))
            {
                var parameters = new DialogParameters<ConfirmDnsRecordPushDialog>
                {
                    { x => x.RecordDescription, "MTA-STS CNAME" },
                    { x => x.RecordName, $"mta-sts.{Domain.Name}" },
                    { x => x.ExistingValue, existing ?? "" },
                    { x => x.ProposedValue, hostingHostname }
                };
                var dialogRef = await DialogService.ShowAsync<ConfirmDnsRecordPushDialog>("Push MTA-STS CNAME", parameters);
                var result = await dialogRef.Result;
                if (result is null || result.Canceled)
                {
                    return;
                }
            }

            await OpenDnsPushPopup(pushProvider.ProviderKey, Domain.Id, "mta-sts");
        }
        finally
        {
            _isPushing = false;
        }
    }

    /// <summary>Runs PollingService's own per-domain MTA-STS check on demand, outside its normal
    /// 15-minute/24-hour schedule - for right after fixing a record, so status updates without
    /// waiting for the next automatic pass. Calls the exact same per-domain state machine the
    /// batch cycle runs (PollingService.RunSingleMtaStsCheckAsync) so this can never drift from
    /// what the scheduled check actually does, including its own internal handling of a
    /// provisioning failure (it sets Failed status and a detail message itself rather than
    /// throwing) - only a DNS/serving-verifier failure can still throw here, hence the catch.</summary>
    private async Task RecheckAsync()
    {
        var hostingHostname = MtaStsOptions.Value.HostingHostname;
        if (string.IsNullOrEmpty(hostingHostname))
        {
            Snackbar.Add("MTA-STS hosting isn't configured on this deployment.", Severity.Warning);
            return;
        }

        _isRechecking = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var domain = await db.Domains.SingleAsync(d => d.Id == Domain.Id);
            try
            {
                await PollingService.RunSingleMtaStsCheckAsync(domain, MtaStsDnsVerifier, MtaStsServingVerifier, MtaStsHostProvisioner, hostingHostname, CancellationToken.None);
            }
            catch (Exception)
            {
                Snackbar.Add($"Failed to check {Domain.Name}'s MTA-STS status. Try again.", Severity.Error);
                return;
            }
            await db.SaveChangesAsync();
            await CheckRecordsAsync();

            Domain.MtaStsStatus = domain.MtaStsStatus;
            Domain.MtaStsCheckedUtc = domain.MtaStsCheckedUtc;
            Domain.MtaStsCheckDetail = domain.MtaStsCheckDetail;
        }
        finally
        {
            _isRechecking = false;
        }
    }
}
